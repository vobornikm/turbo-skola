@page "/"
@rendermode InteractiveServer
@using TurboSkola.Services
@inject IAuthService AuthService

<PageTitle>Turbo Škola: Zkoušej, chybuj, zvítěz!</PageTitle>

<HeadContent>
    <meta name="description" content="Moderní trénink (nejen) malé násobilky pro celou základku. Bezpečné prostředí, kde chyba není problém, ale cesta k úspěchu. Začni trénovat hned!" />
    <meta property="og:title" content="Turbo Škola: Zkoušej, chybuj, zvítěz!" />
    <meta property="og:description" content="Moderní trénink (nejen) malé násobilky pro celou základku. Bezpečné prostředí, kde chyba není problém, ale cesta k úspěchu. Začni trénovat hned!" />
</HeadContent>

<div class="home-page">

    <section class="hero-section">
        <h1 class="hero-title">Turbo Škola – Tvoje cesta<br class="hero-br" /> k super vědomostem!</h1>
        <p class="hero-subtitle">Procvičuj, trénuj a posouvej se dál – ve svém tempu, bez stresu a bez známek.</p>
    </section>

    <div class="turbik-card">
        <div class="turbik-avatar">
            <img src="/images/turbik/turbik.png" alt="Turbík" class="turbik-img" />
            <span class="turbik-name">Turbík</span>
        </div>
        <div class="turbik-says">
            <div class="says-label">💬 Turbík říká:</div>
            <div class="speech-bubble">
                <p>Ahoj! Jsem Turbík a vítám tě v Turbo Škole! 🚀</p>
                <p>
                    Tady se nezkouší a neznámkuje. Tady se <strong>trénuje na plný pecky!</strong>
                    Chceš si procvičit násobilku, češtinu nebo angličtinu?
                    Stačí si vybrat a jít na to.
                </p>
                <p>
                    A pamatuj si moje nejdůležitější pravidlo:<br />
                    <strong class="rule">💥 Zkoušej, chybuj, zvítěz!</strong><br />
                    Když se spleteš, vůbec nic se neděje – prostě to zkusíme znova,
                    dokud na to společně nekápnem. Tak co, zapneme turbo?
                </p>
            </div>
        </div>
    </div>

    <section class="home-cta">
        @if (isAuthenticated)
        {
            <a href="/training" class="btn-cta btn-cta-primary">🚀 Jdeme trénovat!</a>
            <a href="/stats" class="btn-cta btn-cta-secondary">📊 Moje statistiky</a>
        }
        else
        {
            <p class="cta-hint">Trénovat můžeš hned a zdarma – bez registrace. Po registraci navíc získáš přehled statistik a sledování svého pokroku.</p>
            <a href="/auth/register" class="btn-cta btn-cta-primary">🚀 Začít trénovat</a>
            <a href="/auth/login" class="btn-cta btn-cta-secondary">Přihlásit se</a>
        }
    </section>

    <div class="legal-links">
        <a href="/legal/terms">Podmínky používání</a>
        <a href="/legal/privacy">Ochrana osobních údajů</a>
    </div>

</div>

@code {
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(100);
        UpdateAuthState();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            UpdateAuthState();
        }
    }

    private void UpdateAuthState()
    {
        try
        {
            if (AuthService != null)
            {
                isAuthenticated = AuthService.IsAuthenticated;
                StateHasChanged();
            }
        }
        catch
        {
            isAuthenticated = false;
        }
    }
}

<style>
    .home-page {
        max-width: 820px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    /* ── HERO ── */
    .hero-section {
        text-align: center;
        padding: 0.5rem 0 0;
    }

    .hero-title {
        font-size: clamp(1.75rem, 4.5vw, 2.6rem);
        font-weight: 800;
        background: linear-gradient(135deg, #667eea, #764ba2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.25;
        margin-bottom: 1.4rem;
    }

    .hero-br { display: none; }

    .hero-subtitle {
        font-size: 1.05rem;
        color: #666;
        max-width: 500px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* ── TURBÍK CARD ── */
    .turbik-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(102, 126, 234, 0.12);
        border: 1px solid rgba(102, 126, 234, 0.12);
        padding: 2rem 2.25rem;
        display: flex;
        gap: 2rem;
        align-items: flex-start;
    }

    .turbik-avatar {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
    }

    .turbik-img {
        width: 170px;
        height: auto;
        filter: drop-shadow(0 6px 16px rgba(102, 126, 234, 0.22));
    }

    .turbik-name {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #667eea;
    }

    /* Pravý sloupec */
    .turbik-says {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding-top: 0.25rem;
    }

    .says-label {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: #aaa;
    }

    /* Bublina – čistý styl s levým pruhem */
    .speech-bubble {
        background: #f7f8ff;
        border-left: 4px solid #667eea;
        border-radius: 0 16px 16px 16px;
        padding: 1.25rem 1.5rem;
        font-size: 1rem;
        line-height: 1.75;
        color: #333;
    }

    .speech-bubble p {
        margin: 0 0 0.8rem;
    }

    .speech-bubble p:last-child {
        margin-bottom: 0;
    }

    .rule {
        display: inline-block;
        color: #764ba2;
        font-size: 1.05rem;
        margin: 0.5rem 0;
    }

    /* ── CTA ── */
    .home-cta {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-cta {
        display: inline-block;
        padding: 0.9rem 2.25rem;
        border-radius: 2rem;
        font-size: 1.1rem;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .btn-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(102, 126, 234, 0.3);
        text-decoration: none;
    }

    .btn-cta-primary {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
    }

    .btn-cta-secondary {
        background: #fff;
        color: #667eea;
        border: 2px solid #667eea;
    }

    .cta-hint {
        width: 100%;
        text-align: center;
        margin: 0 0 0.5rem;
        font-size: 0.88rem;
        color: #999;
        line-height: 1.5;
    }

    /* ── LEGAL ── */
    .home-cta {
        margin-bottom: 1.5rem;
    }

    .legal-links {
        text-align: center;
        font-size: 0.85rem;
    }

    .legal-links a {
        display: inline-block;
        margin: 0 0.75rem;
        color: #bbb;
        text-decoration: none;
    }

    .legal-links a:hover {
        color: #667eea;
    }

    /* ── MOBILE ── */
    @@media (max-width: 580px) {
        .turbik-card {
            flex-direction: column;
            align-items: center;
            padding: 1.5rem;
        }

        .turbik-img {
            width: 130px;
        }

        .turbik-says {
            width: 100%;
            padding-top: 0;
        }

        .speech-bubble {
            border-radius: 16px;
        }

        .hero-br { display: inline; }
    }
</style>
