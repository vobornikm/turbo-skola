@page "/training/session"
@layout TrainingLayout
@rendermode InteractiveServer
@using TurboSkola.Services
@using TurboSkola.Utilities
@using TurboSkola.Components.Layout
@using System.Diagnostics
@inject ISettingsService SettingsService
@inject ITrainingService TrainingService
@inject ISessionService SessionService
@inject IAuthService AuthService
@inject IProfileService ProfileService
@inject NavigationManager Navigation

<PageTitle>Trénink - Malá Násobilka</PageTitle>

<LoadingSpinner IsLoading="@isSaving" Message="Ukládám výsledky..." />

<div class="training-session-container">
    @if (!isSessionStarted)
    {
        <div class="loading">
            <p>Pøíprava tréninku...</p>
        </div>
    }
    else if (isSessionCompleted)
    {
        <div class="results-container">
            <h1>&#x2605; Výbornì! &#x2605;</h1>
            <div class="results-summary">
                <div class="result-item">
                    <span class="result-label">Doba trvání:</span>
                    <span class="result-value">@TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss")</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Poèet pøíkladù:</span>
                    <span class="result-value">@completedExercises</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Správné napoprvé:</span>
                    <span class="result-value">@correctFirstAttempt / @completedExercises</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Úspìšnost:</span>
                    <span class="result-value">@(completedExercises > 0 ? Math.Round((double)correctFirstAttempt / completedExercises * 100) : 0)%</span>
                </div>
            </div>
            <button class="btn-primary" @onclick="GoHome" disabled="@isSaving">
                @if (isSaving)
                {
                    <span>&#x27F3; Ukládám...</span>
                }
                else
                {
                    <span>&#x2190; Zpìt na domù</span>
                }
            </button>
            <button class="btn-secondary" @onclick="StartNewTraining" disabled="@isSaving">
                Další trénink &#x2192;
            </button>
        </div>
    }
    else if (currentExerciseIndex < exercises.Count)
    {
        <div class="exercise-area">
            <button class="btn-details" @onclick="ToggleDetails">
                &#x24D8; @(showDetails ? "Skrýt" : "Zobrazit") detaily
            </button>

            @if (showDetails)
            {
                <div class="details-panel">
                    <span>@(currentExerciseIndex + 1) / @exercises.Count</span>
                    <span>@TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss") / @TimeSpan.FromSeconds(durationSeconds).ToString(@"mm\:ss")</span>
                </div>
            }

            <div class="exercise-display">
                <div class="exercise-text">
                    @exercises[currentExerciseIndex].Exercise.DisplayText
                </div>
            </div>

            @if (!exercises[currentExerciseIndex].IsCorrect)
            {
                <div class="input-container">
                    <input type="number" 
                           @ref="answerInput"
                           @bind="currentAnswer" 
                           @bind:event="oninput"
                           @onkeydown="OnKeyDown"
                           inputmode="numeric"
                           placeholder="Odpovìï"
                           class="answer-input" />
                    
                    @if (exercises[currentExerciseIndex].Attempts > 0 && !exercises[currentExerciseIndex].IsCorrect)
                    {
                        <div class="wrong-answer">
                            <span class="wrong-text">@exercises[currentExerciseIndex].UserAnswer</span>
                            <span class="hint-text">Zkus znovu</span>
                        </div>
                    }
                </div>

                <div class="button-container">
                    <button class="btn-submit" @onclick="SubmitAnswer" disabled="@string.IsNullOrWhiteSpace(currentAnswer)">
                        &#x2713; Potvrdit
                    </button>
                    
                    <div class="secondary-buttons">
                        <button class="btn-end" @onclick="ShowEndConfirmDialog">
                            &#x25A0; Ukonèit trénink
                        </button>
                        <button class="btn-skip" @onclick="ShowSkipConfirmDialog">
                            &#x2192; Pøeskoèit
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="correct-answer">
                    <div class="correct-label">@exercises[currentExerciseIndex].UserAnswer</div>
                    <span class="checkmark">&#x2713;</span>
                </div>
            }
        </div>
    }
    
    <!-- Potvrzovací dialog pro ukonèení tréninku -->
    @if (showEndConfirm)
    {
        <div class="modal-overlay" @onclick="CancelEndTraining">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h2>&#x26A0; Opravdu chceš skonèit?</h2>
                <p class="motivational-text">Už jsi zvládl @completedExercises pøíkladù! Jsi tak blízko cíle!</p>
                <p class="secondary-text">Pokud teï skonèíš, uloží se tvùj progres.</p>
                <div class="modal-buttons">
                    <button class="btn-modal-cancel" @onclick="CancelEndTraining">
                        &#x2190; Zùstat a pokraèovat
                    </button>
                    <button class="btn-modal-confirm" @onclick="ConfirmEndTraining">
                        &#x2713; Ano, ukonèit
                    </button>
                </div>
            </div>
        </div>
    }
    
    <!-- Potvrzovací dialog pro pøeskoèení -->
    @if (showSkipConfirm)
    {
        <div class="modal-overlay" @onclick="CancelSkip">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h2>&#x2192; Pøeskoèit tento pøíklad?</h2>
                <p class="motivational-text">Zkus to ještì! Urèitì to zvládneš!</p>
                <p class="secondary-text">Pøeskoèené pøíklady se nepoèítají do výsledkù.</p>
                <div class="modal-buttons">
                    <button class="btn-modal-cancel" @onclick="CancelSkip">
                        &#x2190; Zkusím to znovu
                    </button>
                    <button class="btn-modal-confirm" @onclick="ConfirmSkip">
                        &#x2192; Pøeskoèit
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
private List<SessionExerciseData> exercises = new();
private int currentExerciseIndex = 0;
private string currentAnswer = "";
private bool isSessionStarted = false;
private bool isSessionCompleted = false;
private bool isSaving = false;
private bool showDetails = false;
private ElementReference answerInput;
private int sessionId = 0;
private Stopwatch stopwatch = new();
private int elapsedSeconds = 0;
private int durationSeconds = 0;
private int completedExercises = 0;
private int correctFirstAttempt = 0;
private string durationType = "Time";
private bool showEndConfirm = false;
private bool showSkipConfirm = false;
private TrainingSettings? currentSettings = null;

    protected override async Task OnInitializedAsync()
    {
        // Nejdøív zkusit naèíst nastavení z SessionService
        var settings = SessionService.GetCurrentSettings();
        
        // Pokud nejsou v SessionService, naèíst z DB (pro pøihlášené)
        if (settings == null)
        {
            settings = await SettingsService.GetProfileSettingsAsync(null);
        }

        currentSettings = settings; // Uložit pro pozdìjší použití
        durationType = settings.DurationType;
        
        if (settings.DurationType == "Time")
        {
            durationSeconds = settings.DurationValue * 60;
            GenerateExercisesForTime(settings);
        }
        else
        {
            durationSeconds = settings.DurationValue * 30;
            GenerateExercisesForCount(settings);
        }

        sessionId = (await TrainingService.CreateSessionAsync(
            ProfileService.CurrentProfileId,
            settings.IncludedMultipliers,
            settings.IncludeMultiplication,
            settings.IncludeDivision,
            durationSeconds,
            settings.DurationType == "Count" ? settings.DurationValue : null
        )).SessionId;

        stopwatch.Start();
        isSessionStarted = true;
        _ = UpdateTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Nekontrolovat focus pokud je session dokonèená (input už neexistuje)
        if (isSessionCompleted)
            return;
            
        if (firstRender && answerInput.Id != null)
        {
            await answerInput.FocusAsync();
        }
        else if (!firstRender && currentExerciseIndex < exercises.Count && answerInput.Id != null)
        {
            await answerInput.FocusAsync();
        }
    }

    private void GenerateExercisesForTime(TrainingSettings settings)
    {
        // Pro èasový režim zaèneme s malým poètem a budeme je generovat za bìhu
        var generator = new ExerciseGenerator();
        var initialCount = 10; // Zaèneme s 10 pøíklady
        var generatedExercises = generator.GenerateExercises(
            initialCount,
            settings.IncludedMultipliers,
            settings.IncludeMultiplication,
            settings.IncludeDivision
        );

        exercises = generatedExercises.Select((ex, idx) => new SessionExerciseData
        {
            Index = idx,
            Exercise = ex,
            Attempts = 0,
            IsCorrect = false,
            IsSkipped = false,
            TimeSpentSeconds = 0,
            StartTime = DateTime.UtcNow
        }).ToList();
    }

    private void GenerateExercisesForCount(TrainingSettings settings)
    {
        var generator = new ExerciseGenerator();
        var generatedExercises = generator.GenerateExercises(
            settings.DurationValue,
            settings.IncludedMultipliers,
            settings.IncludeMultiplication,
            settings.IncludeDivision
        );

        exercises = generatedExercises.Select((ex, idx) => new SessionExerciseData
        {
            Index = idx,
            Exercise = ex,
            Attempts = 0,
            IsCorrect = false,
            IsSkipped = false,
            TimeSpentSeconds = 0,
            StartTime = DateTime.UtcNow
        }).ToList();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        Console.WriteLine($"Key pressed: {e.Key}");
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            Console.WriteLine("Enter detected, submitting answer...");
            await SubmitAnswer();
        }
    }

    private async Task SubmitAnswer()
    {
        if (string.IsNullOrWhiteSpace(currentAnswer))
            return;

        if (!int.TryParse(currentAnswer, out int answer))
            return;

        var currentExercise = exercises[currentExerciseIndex];
        currentExercise.Attempts++;
        currentExercise.UserAnswer = answer;

        if (answer == currentExercise.Exercise.CorrectAnswer)
        {
            currentExercise.IsCorrect = true;
            currentExercise.TimeSpentSeconds = (int)(DateTime.UtcNow - currentExercise.StartTime).TotalSeconds;
            if (currentExercise.Attempts == 1)
                correctFirstAttempt++;
            completedExercises++;

            if (elapsedSeconds >= durationSeconds && durationType == "Time")
            {
                await CompleteSessionAsync();
                return;
            }

            currentExerciseIndex++;
            currentAnswer = "";

            // Pro èasový režim: generovat nové pøíklady když se blíží konec
            if (durationType == "Time" && currentExerciseIndex >= exercises.Count - 3)
            {
                GenerateMoreExercises();
            }

            if (currentExerciseIndex < exercises.Count)
            {
                exercises[currentExerciseIndex].StartTime = DateTime.UtcNow;
                StateHasChanged();
            }
            else
            {
                await CompleteSessionAsync();
            }
        }
        else
        {
            // Špatná odpovìï - vymazat pole pro nový pokus
            currentAnswer = "";
            StateHasChanged();
        }
    }

    private async Task SkipExercise()
    {
        var currentExercise = exercises[currentExerciseIndex];
        currentExercise.IsSkipped = true;
        currentExercise.TimeSpentSeconds = (int)(DateTime.UtcNow - currentExercise.StartTime).TotalSeconds;

        currentExerciseIndex++;
        currentAnswer = "";

        if (currentExerciseIndex < exercises.Count)
        {
            exercises[currentExerciseIndex].StartTime = DateTime.UtcNow;
            StateHasChanged();
        }
        else
        {
            await CompleteSessionAsync();
        }
    }

    private void ToggleDetails()
    {
        showDetails = !showDetails;
    }

    private async Task CompleteSessionAsync()
    {
        stopwatch.Stop();
        isSessionCompleted = true;
        isSaving = true;
        StateHasChanged();
        
        // Pøipravit data pro uložení
        var exercisesToSave = new List<Data.Models.SessionExercise>();
        
        foreach (var ex in exercises.Where(e => !e.IsSkipped && e.Attempts > 0))
        {
            exercisesToSave.Add(new Data.Models.SessionExercise
            {
                SessionId = sessionId,
                ExerciseIndex = ex.Index,
                ExerciseText = ex.Exercise.DisplayText,
                CorrectAnswer = ex.Exercise.CorrectAnswer,
                UserAnswer = ex.UserAnswer ?? 0,
                TimeSpentSeconds = ex.TimeSpentSeconds,
                NumberOfAttempts = ex.Attempts,
                IsCorrect = ex.IsCorrect,
                SkippedByUser = ex.IsSkipped
            });
        }
        
        // Batch save všech výsledkù najednou
        try
        {
            await TrainingService.CompleteSessionAsync(sessionId, correctFirstAttempt, exercises.Sum(e => e.Attempts), exercisesToSave);
            Console.WriteLine("? Session saved successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"!!! Error saving session: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
        
        StateHasChanged();
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private void StartNewTraining()
    {
        Navigation.NavigateTo("/training/setup");
    }

    private async Task UpdateTimer()
    {
        while (!isSessionCompleted && stopwatch.IsRunning)
        {
            await Task.Delay(1000);
            elapsedSeconds = (int)stopwatch.Elapsed.TotalSeconds;
            StateHasChanged();

            if (elapsedSeconds >= durationSeconds && exercises.Count > 0 && currentExerciseIndex < exercises.Count && durationType == "Time")
            {
                await CompleteSessionAsync();
            }
        }
    }

    private void ShowEndConfirmDialog()
    {
        Console.WriteLine(">>> Zobrazuji dialog pro ukonèení tréninku");
        showEndConfirm = true;
    }

    private void CancelEndTraining()
    {
        Console.WriteLine(">>> Zrušeno ukonèení, pokraèuji v tréninku");
        showEndConfirm = false;
    }

    private async Task ConfirmEndTraining()
    {
        Console.WriteLine(">>> Potvrzeno ukonèení tréninku");
        showEndConfirm = false;
        await EndTrainingEarly();
    }

    private void ShowSkipConfirmDialog()
    {
        Console.WriteLine(">>> Zobrazuji dialog pro pøeskoèení");
        showSkipConfirm = true;
    }

    private void CancelSkip()
    {
        Console.WriteLine(">>> Zrušeno pøeskoèení, pokraèuji");
        showSkipConfirm = false;
    }

    private async Task ConfirmSkip()
    {
        Console.WriteLine(">>> Potvrzeno pøeskoèení");
        showSkipConfirm = false;
        await SkipExercise();
    }

    private async Task EndTrainingEarly()
    {
        Console.WriteLine(">>> Trénink ukonèen pøedèasnì!");
        await CompleteSessionAsync();
    }

    private void GenerateMoreExercises()
    {
        if (currentSettings == null || durationType != "Time")
            return;

        Console.WriteLine(">>> Generuji dalších 10 pøíkladù...");
        
        var generator = new ExerciseGenerator();
        var newExercises = generator.GenerateExercises(
            10, // Vygenerovat dalších 10
            currentSettings.IncludedMultipliers,
            currentSettings.IncludeMultiplication,
            currentSettings.IncludeDivision
        );

        var startIndex = exercises.Count;
        foreach (var (ex, idx) in newExercises.Select((ex, idx) => (ex, idx)))
        {
            exercises.Add(new SessionExerciseData
            {
                Index = startIndex + idx,
                Exercise = ex,
                Attempts = 0,
                IsCorrect = false,
                IsSkipped = false,
                TimeSpentSeconds = 0,
                StartTime = DateTime.UtcNow
            });
        }
        
        Console.WriteLine($">>> Celkem pøíkladù: {exercises.Count}");
    }
}

