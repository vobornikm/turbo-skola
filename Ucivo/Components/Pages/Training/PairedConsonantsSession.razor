@page "/training/czech/paired-consonants/session"
@layout TrainingLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TurboSkola.Services
@using TurboSkola.TrainingGenerators
@using TurboSkola.Components.Layout
@using System.Diagnostics
@inject ITrainingService TrainingService
@inject ISessionService SessionService
@inject IAuthService AuthService
@inject IProfileService ProfileService
@inject NavigationManager Navigation
@inject TurboSkola.Data.UcivoDbContext DbContext

<PageTitle>Trénink - Párové souhlásky</PageTitle>

<LoadingSpinner IsLoading="@isSaving" Message="Ukládám výsledky..." />

<div class="training-session-container">
    @if (!isSessionStarted)
    {
        <div class="loading">
            <p>Příprava tréninku...</p>
        </div>
    }
    else if (isSessionCompleted)
    {
        <div class="results-container">
            <h1>&#x2605; Výborně! &#x2605;</h1>
            <div class="results-summary">
                <div class="result-item">
                    <span class="result-label">Doba trvání:</span>
                    <span class="result-value">@TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss")</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Počet slov:</span>
                    <span class="result-value">@totalExercisesSeen</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Správně napoprvé:</span>
                    <span class="result-value">@correctFirstAttempt / @totalExercisesSeen</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Úspěšnost:</span>
                    <span class="result-value">@(totalExercisesSeen > 0 ? Math.Round((double)correctFirstAttempt / totalExercisesSeen * 100) : 0)%</span>
                </div>
            </div>
            <div class="results-actions">
                <button class="btn-result-primary" @onclick="NextTraining" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span>&#x27F3; Ukládám...</span>
                    }
                    else
                    {
                        <span>&#x1F680; Další trénink</span>
                    }
                </button>
                <div class="results-ghost-row">
                    <button class="btn-result-ghost" @onclick="GoToStats" disabled="@isSaving">
                        &#x1F4CA; Zobrazit odpovědi
                    </button>
                    <button class="btn-result-ghost" @onclick="GoToTrainingHub" disabled="@isSaving">
                        &#x1F500; Jiný trénink
                    </button>
                </div>
                <button class="btn-result-ghost full-width" @onclick="GoHome" disabled="@isSaving">
                    &#x1F3E0; Zpět na domů
                </button>
            </div>
        </div>
    }
    else if (currentExerciseIndex < exercises.Count)
    {
        <div class="exercise-area">
            <button class="btn-details" @onclick="ToggleDetails">
                &#x24D8; @(showDetails ? "Skrýt" : "Zobrazit") detaily
            </button>

            @if (showDetails)
            {
                <div class="details-panel">
                    <span class="detail-mode">@((MarkupString)(durationType == "Time" ? "&#x23F1; Čas" : "&#x1F522; Počet"))</span>
                    <span class="detail-item @(durationType == "Count" ? "detail-limit" : "")">
                        @(completedExercises)@(durationType == "Count" ? $" / {exercises.Count}" : "") příkladů
                    </span>
                    <span class="detail-item @(durationType == "Time" ? "detail-limit" : "")">
                        @TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss")@(durationType == "Time" ? $" / {TimeSpan.FromSeconds(durationSeconds).ToString(@"mm\:ss")}" : "")
                    </span>
                </div>
            }

            @{
                var currentEx = exercises[currentExerciseIndex];
            }

            <div class="exercise-display">
                @if (currentEx.IsCorrect && currentSettings!.ShowFullWordAfterAnswer)
                {
                    <div class="word-reveal" @key="@($"reveal-{currentExerciseIndex}")">
                        <span class="full-word">@currentEx.Exercise.FullWord</span>
                    </div>
                }
                else
                {
                    <div class="word-display" @key="currentExerciseIndex">
                        @{
                            var display = currentEx.Exercise.WordWithBlank;
                            var blankIdx = display.IndexOf('_');
                        }
                        @if (blankIdx >= 0)
                        {
                            <span class="word-before">@display[..blankIdx]</span><span class="word-blank"></span><span class="word-after">@display[(blankIdx + 1)..]</span>
                        }
                        else
                        {
                            <span class="word-before">@display</span>
                        }
                    </div>
                }
            </div>

            @if (!currentEx.IsCorrect)
            {
                @if (currentEx.Attempts > 0)
                {
                    <div class="wrong-answer">
                        <span class="wrong-text">@currentEx.UserAnswer</span>
                        <span class="hint-text">Nevadí, zkus znovu</span>
                        @if (currentEx.Attempts >= 2)
                        {
                            <div class="hint-buttons">
                                @if (currentEx.Attempts >= 3)
                                {
                                    <button class="btn-giveup" @onclick="ShowGiveUpDialog">&#x1F3F3;&#xFE0F; Dám se podat</button>
                                }
                            </div>
                        }
                    </div>
                }

                @if (currentSettings!.ShowAnswerButtons)
                {
                    <!-- ODPOVĚĎ TLAČÍTKY -->
                    <div class="answer-buttons-container">
                        @foreach (var option in currentAnswerOptions)
                        {
                            <button class="answer-btn" @onclick="() => SubmitButtonAnswer(option)">
                                @option.ToUpper()
                            </button>
                        }
                    </div>
                }
                else
                {
                    <!-- ODPOVĚĎ KLÁVESNICÍ -->
                    <div class="input-container">
                        <input type="text"
                               @ref="answerInput"
                               @bind="currentAnswer"
                               @bind:event="oninput"
                               @onkeydown="OnKeyDown"
                               placeholder="Doplň písmeno"
                               class="answer-input"
                               maxlength="2"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="off"
                               spellcheck="false" />
                    </div>

                    <div class="button-container">
                        <button class="btn-submit" @onclick="SubmitTextAnswer" disabled="@string.IsNullOrWhiteSpace(currentAnswer)">
                            &#x2713; Potvrdit
                        </button>
                        <div class="secondary-buttons">
                            <button class="btn-end" @onclick="ShowEndConfirmDialog">&#x25A0; Ukončit trénink</button>
                            <button class="btn-skip" @onclick="ShowSkipConfirmDialog">&#x2192; Přeskočit</button>
                        </div>
                    </div>
                }

                @if (currentSettings.ShowAnswerButtons)
                {
                    <div class="button-container buttons-only-controls">
                        <div class="secondary-buttons">
                            <button class="btn-end" @onclick="ShowEndConfirmDialog">&#x25A0; Ukončit trénink</button>
                            <button class="btn-skip" @onclick="ShowSkipConfirmDialog">&#x2192; Přeskočit</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="correct-answer">
                    <div class="correct-label">@(currentEx.UserAnswer?.ToUpper() ?? currentEx.Exercise.CorrectLetter.ToUpper())</div>
                    <span class="checkmark">&#x2713;</span>
                    @if (currentEx.Exercise.IsAmbiguous)
                    {
                        <span class="ambiguous-hint">Obě písmena jsou správně!</span>
                    }
                </div>
            }
        </div>
    }

    @if (showEndConfirm)
    {
        <div class="modal-overlay" @onclick="CancelEndTraining">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h2>&#x26A0; Opravdu chceš skončit?</h2>
                <p class="motivational-text">Už jsi zvládl @completedExercises slov! Jsi tak blízko cíle!</p>
                <p class="secondary-text">Pokud teď skončíš, uloží se tvůj progres.</p>
                <div class="modal-buttons">
                    <button class="btn-modal-cancel" @onclick="CancelEndTraining">&#x2190; Zůstat a pokračovat</button>
                    <button class="btn-modal-confirm" @onclick="ConfirmEndTraining">&#x2713; Ano, ukončit</button>
                </div>
            </div>
        </div>
    }

    @if (showSkipConfirm)
    {
        <div class="modal-overlay" @onclick="CancelSkip">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h2>&#x2192; Přeskočit toto slovo?</h2>
                <p class="motivational-text">Zkus to ještě! Určitě to zvládneš!</p>
                <div class="modal-buttons">
                    <button class="btn-modal-cancel" @onclick="CancelSkip">&#x2190; Zkusím to znovu</button>
                    <button class="btn-modal-confirm" @onclick="ConfirmSkip">&#x2192; Přeskočit</button>
                </div>
            </div>
        </div>
    }

    @if (showGiveUpDialog)
    {
        <div class="modal-overlay" @onclick="CloseGiveUpDialog">
            <div class="modal-content hint-modal" @onclick:stopPropagation="true">
                <h2>&#x1F4A1; Správné řešení</h2>
                @if (currentExerciseIndex < exercises.Count)
                {
                    var ex = exercises[currentExerciseIndex].Exercise;
                    @if (ex.IsAmbiguous)
                    {
                        <p class="hint-dialog-text">
                            Správně jsou <strong>obě písmena</strong>!
                        </p>
                        @foreach (var (letter, word) in ex.AnswerToFullWord)
                        {
                            <div class="solution-box">
                                <span class="solution-label">@letter.ToUpper() →</span>
                                <span class="solution-text">@word</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="hint-dialog-text">
                            Hledané písmeno je <strong>@ex.CorrectLetter.ToUpper()</strong>.
                        </p>
                        <div class="solution-box">
                            <span class="solution-label">Celé slovo:</span>
                            <span class="solution-text">@ex.FullWord</span>
                        </div>
                    }
                }
                <div class="modal-buttons">
                    <button class="btn-modal-cancel" @onclick="ConfirmGiveUp">Rozumím, jdeme dál &#x2192;</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CzechSessionExerciseData> exercises = new();
    private int currentExerciseIndex = 0;
    private string currentAnswer = "";
    private bool isSessionStarted = false;
    private bool isSessionCompleted = false;
    private bool isSaving = false;
    private bool showDetails = false;
    private ElementReference answerInput;
    private int sessionId = 0;
    private Stopwatch stopwatch = new();
    private int elapsedSeconds = 0;
    private int durationSeconds = 0;
    private int completedExercises = 0;
    private int totalExercisesSeen = 0;
    private int correctFirstAttempt = 0;
    private string durationType = "Time";
    private bool showEndConfirm = false;
    private bool showSkipConfirm = false;
    private bool showGiveUpDialog = false;
    private PairedConsonantsTrainingSettings? currentSettings = null;
    private PairedConsonantsGenerator? _generator = null;
    private List<string> currentAnswerOptions = new();

    protected override async Task OnInitializedAsync()
    {
        var settings = SessionService.GetCurrentPairedConsonantsSettings() ?? new PairedConsonantsTrainingSettings();
        currentSettings = settings;
        durationType = settings.DurationType;

        // Načíst zablokovaná slova
        var blockedWords = DbContext.BlockedWords
            .Where(b => b.TrainingTypeCode == "PAIRED_CONSONANTS")
            .Select(b => b.FullWord.ToLower())
            .ToHashSet();

        _generator = new PairedConsonantsGenerator(settings, blockedWords);

        if (settings.DurationType == "Time")
        {
            durationSeconds = settings.DurationValue * 60;
            GenerateExercisesForTime();
        }
        else
        {
            durationSeconds = settings.DurationValue * 30;
            GenerateExercisesForCount(settings.DurationValue);
        }

        // Nastavit odpovědní tlačítka pro první cvičení
        if (exercises.Count > 0)
            currentAnswerOptions = _generator.GetAnswerOptions(exercises[0].Exercise);

        sessionId = (await TrainingService.CreateSessionAsync(
            ProfileService.CurrentProfileId,
            durationSeconds,
            settings.DurationType == "Count" ? settings.DurationValue : null,
            "PAIRED_CONSONANTS"
        )).SessionId;

        stopwatch.Start();
        isSessionStarted = true;
        _ = UpdateTimer();
    }

    private int _lastFocusedExerciseIndex = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isSessionCompleted) return;
        if (currentSettings?.ShowAnswerButtons == true) return;
        if (answerInput.Id == null) return;
        if (currentExerciseIndex >= exercises.Count) return;

        if (currentExerciseIndex != _lastFocusedExerciseIndex)
        {
            _lastFocusedExerciseIndex = currentExerciseIndex;
            if (!firstRender) await Task.Delay(50);
            await answerInput.FocusAsync();
        }
    }

    private void GenerateExercisesForTime()
    {
        exercises = Enumerable.Range(0, 10).Select((_, idx) => new CzechSessionExerciseData
        {
            Index = idx,
            Exercise = _generator!.GenerateExercise(),
            Attempts = 0,
            IsCorrect = false,
            IsSkipped = false,
            TimeSpentSeconds = 0,
            StartTime = DateTime.UtcNow
        }).ToList();
    }

    private void GenerateExercisesForCount(int count)
    {
        exercises = Enumerable.Range(0, count).Select((_, idx) => new CzechSessionExerciseData
        {
            Index = idx,
            Exercise = _generator!.GenerateExercise(),
            Attempts = 0,
            IsCorrect = false,
            IsSkipped = false,
            TimeSpentSeconds = 0,
            StartTime = DateTime.UtcNow
        }).ToList();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            await SubmitTextAnswer();
        }
    }

    private async Task SubmitButtonAnswer(string answer)
    {
        await ProcessAnswer(answer.ToLower());
    }

    private async Task SubmitTextAnswer()
    {
        if (string.IsNullOrWhiteSpace(currentAnswer)) return;
        await ProcessAnswer(currentAnswer.Trim().ToLower());
    }

    private async Task ProcessAnswer(string answer)
    {
        var currentExercise = exercises[currentExerciseIndex];
        currentExercise.Attempts++;
        currentExercise.UserAnswer = answer;

        if (currentExercise.Exercise.AcceptedAnswers.Contains(answer))
        {
            currentExercise.IsCorrect = true;
            currentExercise.TimeSpentSeconds = (int)(DateTime.UtcNow - currentExercise.StartTime).TotalSeconds;
            if (currentExercise.Attempts == 1)
                correctFirstAttempt++;
            completedExercises++;

            // Pokud odpověděl jedním z více platných písmen, ukáž odpovídající celé slovo
            if (currentExercise.Exercise.AnswerToFullWord.TryGetValue(answer, out var matchedWord))
                currentExercise.Exercise.FullWord = matchedWord;

            if (currentSettings!.ShowFullWordAfterAnswer)
            {
                StateHasChanged();
                await Task.Delay(800);
            }

            if (elapsedSeconds >= durationSeconds && durationType == "Time")
            {
                await CompleteSessionAsync();
                return;
            }

            MoveToNextExercise();
        }
        else
        {
            currentExercise.WrongAnswers.Add(answer);
            currentAnswer = "";
            StateHasChanged();
            if (!currentSettings!.ShowAnswerButtons && answerInput.Id != null)
                await answerInput.FocusAsync();
        }
    }

    private void MoveToNextExercise()
    {
        currentExerciseIndex++;
        currentAnswer = "";

        if (durationType == "Time" && currentExerciseIndex >= exercises.Count - 3)
        {
            GenerateMoreExercises();
        }

        if (currentExerciseIndex < exercises.Count)
        {
            exercises[currentExerciseIndex].StartTime = DateTime.UtcNow;
            currentAnswerOptions = _generator!.GetAnswerOptions(exercises[currentExerciseIndex].Exercise);
            StateHasChanged();
        }
        else
        {
            _ = CompleteSessionAsync();
        }
    }

    private async Task SkipExercise()
    {
        var currentExercise = exercises[currentExerciseIndex];
        currentExercise.IsSkipped = true;
        currentExercise.TimeSpentSeconds = (int)(DateTime.UtcNow - currentExercise.StartTime).TotalSeconds;

        currentExerciseIndex++;
        currentAnswer = "";

        if (currentExerciseIndex < exercises.Count)
        {
            exercises[currentExerciseIndex].StartTime = DateTime.UtcNow;
            currentAnswerOptions = _generator!.GetAnswerOptions(exercises[currentExerciseIndex].Exercise);
            StateHasChanged();
        }
        else
        {
            await CompleteSessionAsync();
        }
    }

    private void ToggleDetails()
    {
        showDetails = !showDetails;
    }

    private async Task CompleteSessionAsync()
    {
        stopwatch.Stop();
        isSessionCompleted = true;
        isSaving = true;
        StateHasChanged();

        var exercisesToSave = new List<Data.Models.SessionExercise>();

        foreach (var ex in exercises.Where(e => e.Attempts > 0 || e.IsSkipped || e.GaveUp))
        {
            exercisesToSave.Add(new Data.Models.SessionExercise
            {
                SessionId = sessionId,
                ExerciseIndex = ex.Index,
                ExerciseText = ex.Exercise.WordWithBlank,
                CorrectAnswer = ex.Exercise.CorrectLetter == ex.Exercise.PairOption1 ? 0 : 1,
                UserAnswer = ex.UserAnswer == ex.Exercise.PairOption1 ? 0 : 1,
                TimeSpentSeconds = ex.TimeSpentSeconds,
                NumberOfAttempts = ex.Attempts,
                IsCorrect = ex.IsCorrect,
                SkippedByUser = ex.IsSkipped,
                GaveUp = ex.GaveUp,
                HintShown = ex.HintShown,
                WrongAnswers = ex.WrongAnswers.Count > 0
                    ? string.Join(",", ex.WrongAnswers)
                    : null
            });
        }

        totalExercisesSeen = exercisesToSave.Count;

        try
        {
            if (totalExercisesSeen == 0)
            {
                await TrainingService.DeleteSessionAsync(sessionId);
                Console.WriteLine("Empty session deleted.");
            }
            else
            {
                await TrainingService.CompleteSessionAsync(sessionId, correctFirstAttempt, exercises.Sum(e => e.Attempts), exercisesToSave);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving session: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }

        StateHasChanged();
    }

    private void GoHome() => Navigation.NavigateTo("/");

    private void GoToStats() => Navigation.NavigateTo($"/stats?session={sessionId}");

    private void GoToTrainingHub() => Navigation.NavigateTo("/training");

    private void NextTraining()
    {
        if (SessionService.ActivePreparedTrainingId.HasValue)
        {
            SessionService.ClearActivePreparedTraining();
            Navigation.NavigateTo("/training/prepared");
        }
        else
        {
            Navigation.NavigateTo("/training/czech/paired-consonants/setup");
        }
    }

    private async Task UpdateTimer()
    {
        while (!isSessionCompleted && stopwatch.IsRunning)
        {
            await Task.Delay(1000);
            elapsedSeconds = (int)stopwatch.Elapsed.TotalSeconds;
            StateHasChanged();

            if (elapsedSeconds >= durationSeconds && exercises.Count > 0 && currentExerciseIndex < exercises.Count && durationType == "Time")
            {
                await CompleteSessionAsync();
            }
        }
    }

    private void ShowEndConfirmDialog() { showEndConfirm = true; }
    private void CancelEndTraining() { showEndConfirm = false; }
    private async Task ConfirmEndTraining() { showEndConfirm = false; await EndTrainingEarly(); }
    private void ShowSkipConfirmDialog() { showSkipConfirm = true; }
    private void CancelSkip() { showSkipConfirm = false; }
    private async Task ConfirmSkip() { showSkipConfirm = false; await SkipExercise(); }
    private void ShowGiveUpDialog() { showGiveUpDialog = true; }
    private void CloseGiveUpDialog() { showGiveUpDialog = false; }

    private async Task ConfirmGiveUp()
    {
        showGiveUpDialog = false;
        var currentExercise = exercises[currentExerciseIndex];
        currentExercise.TimeSpentSeconds = (int)(DateTime.UtcNow - currentExercise.StartTime).TotalSeconds;
        currentExercise.GaveUp = true;

        currentExerciseIndex++;
        currentAnswer = "";

        if (durationType == "Time" && currentExerciseIndex >= exercises.Count - 3)
            GenerateMoreExercises();

        if (currentExerciseIndex < exercises.Count)
        {
            exercises[currentExerciseIndex].StartTime = DateTime.UtcNow;
            currentAnswerOptions = _generator!.GetAnswerOptions(exercises[currentExerciseIndex].Exercise);
            StateHasChanged();
        }
        else
        {
            await CompleteSessionAsync();
        }
    }

    private async Task EndTrainingEarly()
    {
        await CompleteSessionAsync();
    }

    private void GenerateMoreExercises()
    {
        if (_generator == null || durationType != "Time")
            return;

        var startIndex = exercises.Count;
        for (int i = 0; i < 10; i++)
        {
            exercises.Add(new CzechSessionExerciseData
            {
                Index = startIndex + i,
                Exercise = _generator.GenerateExercise(),
                Attempts = 0,
                IsCorrect = false,
                IsSkipped = false,
                TimeSpentSeconds = 0,
                StartTime = DateTime.UtcNow
            });
        }
    }
}

<style>
    .training-session-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: var(--training-vh, 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        background: linear-gradient(135deg, #48bb78 0%, #276749 100%);
        padding: 0.75rem 1rem;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow: hidden;
    }

    .loading {
        color: white;
        font-size: 1.2rem;
    }

    .exercise-area {
        width: 100%;
        max-width: 500px;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .btn-details {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.4);
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8rem;
        align-self: flex-start;
        flex-shrink: 0;
    }

    .btn-details:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    .details-panel {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.82rem;
        margin-bottom: 0.75rem;
        padding: 0 0.5rem;
        flex-wrap: wrap;
    }

    .detail-mode {
        background: rgba(255, 255, 255, 0.15);
        padding: 0.15rem 0.5rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.85);
        letter-spacing: 0.02em;
    }

    .detail-item {
        white-space: nowrap;
    }

    .detail-item.detail-limit {
        color: rgba(255, 255, 255, 0.9);
        font-weight: 600;
    }

    /* WORD DISPLAY */
    .exercise-display {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: clamp(3.2rem, 15vw, 6.5rem);
    }

    .word-display {
        font-size: clamp(3rem, 14vw, 6rem);
        font-weight: bold;
        color: white;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        text-align: center;
        line-height: 1.2;
        animation: exampleIn 0.18s ease;
    }

    .word-before, .word-after {
        color: white;
    }

    .word-blank {
        display: inline-block;
        width: 0.55em;
        border-bottom: 4px solid rgba(255, 215, 0, 0.7);
        margin: 0 0.06em 0.05em;
        vertical-align: baseline;
    }

    .word-reveal {
        animation: revealIn 0.35s ease;
    }

    .full-word {
        font-size: clamp(3rem, 14vw, 6rem);
        font-weight: bold;
        color: #ffd700;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        letter-spacing: 0.05em;
    }

    @@keyframes exampleIn {
        from { opacity: 0; transform: scale(0.92); }
        to   { opacity: 1; transform: scale(1); }
    }

    @@keyframes revealIn {
        from { opacity: 0; transform: scale(1.1); }
        to   { opacity: 1; transform: scale(1); }
    }

    /* ANSWER BUTTONS */
    .answer-buttons-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        width: 100%;
        max-width: 400px;
        margin-bottom: 0.75rem;
    }

    .answer-btn {
