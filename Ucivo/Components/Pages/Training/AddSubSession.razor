@page "/training/addsub/session"
@layout TrainingLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TurboSkola.Services
@using TurboSkola.Utilities
@using TurboSkola.TrainingGenerators
@using TurboSkola.Components.Layout
@using System.Diagnostics
@inject ITrainingService TrainingService
@inject ISessionService SessionService
@inject IAuthService AuthService
@inject IProfileService ProfileService
@inject NavigationManager Navigation

<PageTitle>Trénink - Sčítání a odčítání</PageTitle>

<LoadingSpinner IsLoading="@isSaving" Message="Ukládám výsledky..." />

<div class="training-session-container">
    @if (!isSessionStarted)
    {
        <div class="loading">
            <p>Příprava tréninku...</p>
        </div>
    }
    else if (isSessionCompleted)
    {
        <div class="results-container">
            <h1>&#x2605; Výborně! &#x2605;</h1>
            <div class="results-summary">
                <div class="result-item">
                    <span class="result-label">Doba trvání:</span>
                    <span class="result-value">@TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss")</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Počet příkladů:</span>
                    <span class="result-value">@totalExercisesSeen</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Správné napoprvé:</span>
                    <span class="result-value">@correctFirstAttempt / @totalExercisesSeen</span>
                </div>
                <div class="result-item">
                    <span class="result-label">Úspěšnost:</span>
                    <span class="result-value">@(totalExercisesSeen > 0 ? Math.Round((double)correctFirstAttempt / totalExercisesSeen * 100) : 0)%</span>
                </div>
            </div>
            <button class="btn-primary" @onclick="GoHome" disabled="@isSaving">
                @if (isSaving)
                {
                    <span>&#x27F3; Ukládám...</span>
                }
                else
                {
                    <span>&#x2190; Zpět na domů</span>
                }
            </button>
            <button class="btn-secondary" @onclick="StartNewTraining" disabled="@isSaving">
                Další trénink &#x2192;
            </button>
        </div>
    }
    else if (currentExerciseIndex < exercises.Count)
    {
        <div class="exercise-area">
            <button class="btn-details" @onclick="ToggleDetails">
                &#x24D8; @(showDetails ? "Skrýt" : "Zobrazit") detaily
            </button>

            @if (showDetails)
            {
                <div class="details-panel">
                    <span>@(currentExerciseIndex + 1) / @exercises.Count</span>
                    <span>@TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss") / @TimeSpan.FromSeconds(durationSeconds).ToString(@"mm\:ss")</span>
                </div>
            }

            <div class="exercise-display">
                <div class="exercise-text" @key="currentExerciseIndex" style="font-size: @GetExerciseFontSize()">
                    @exercises[currentExerciseIndex].Exercise.DisplayText
                </div>
            </div>

            @if (!exercises[currentExerciseIndex].IsCorrect)
            {
                <div class="input-container">
                    @if (exercises[currentExerciseIndex].Attempts > 0 && !exercises[currentExerciseIndex].IsCorrect)
                    {
                        <div class="wrong-answer">
                            <span class="wrong-text">@exercises[currentExerciseIndex].UserAnswer</span>
                            <span class="hint-text">Nevadí, zkus znovu</span>
                            @if (exercises[currentExerciseIndex].Attempts >= 2)
                            {
                                <div class="hint-buttons">
                                    <button class="btn-hint" @onclick="ShowHintDialog">&#x1F4A1; Chci poradit</button>
                                    @if (exercises[currentExerciseIndex].Attempts >= 3)
                                    {
                                        <button class="btn-giveup" @onclick="ShowGiveUpDialog">&#x1F3F3;&#xFE0F; Dám se podat</button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <input type="number"
                           @ref="answerInput"
                           @bind="currentAnswer"
                           @bind:event="oninput"
                           @onkeydown="OnKeyDown"
                           inputmode="numeric"
                           placeholder="Odpověď"
                           class="answer-input" />
                </div>

                <div class="button-container">
                    <button class="btn-submit" @onclick="SubmitAnswer" disabled="@string.IsNullOrWhiteSpace(currentAnswer)">
                        &#x2713; Potvrdit
                    </button>
                    <div class="secondary-buttons">
                        <button class="btn-end" @onclick="ShowEndConfirmDialog">&#x25A0; Ukončit trénink</button>
                        <button class="btn-skip" @onclick="ShowSkipConfirmDialog">&#x2192; Přeskočit</button>
                    </div>
                </div>
            }
            else
            {
                <div class="correct-answer">
                    <div class="correct-label">@exercises[currentExerciseIndex].UserAnswer</div>
                    <span class="checkmark">&#x2713;</span>
                </div>
            }
        </div>
    }

    @if (showEndConfirm)
    {
        <div class="modal-overlay" @onclick="CancelEndTraining">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h2>&#x26A0; Opravdu chceš skončit?</h2>
                <p class="motivational-text">Už jsi zvládl @completedExercises příkladů! Jsi tak blízko cíle!</p>
                <p class="secondary-text">Pokud teď skončíš, uloží se tvůj progres.</p>
                <div class="modal-buttons">
                    <button class="btn-modal-cancel" @onclick="CancelEndTraining">&#x2190; Zůstat a pokračovat</button>
                    <button class="btn-modal-confirm" @onclick="ConfirmEndTraining">&#x2713; Ano, ukončit</button>
                </div>
            </div>
        </div>
    }

    @if (showSkipConfirm)
    {
        <div class="modal-overlay" @onclick="CancelSkip">
            <div class="modal-content" @onclick:stopPropagation="true">
                <h2>&#x2192; Přeskočit tento příklad?</h2>
                <p class="motivational-text">Zkus to ještě! Určitě to zvládneš!</p>
                <div class="modal-buttons">
                    <button class="btn-modal-cancel" @onclick="CancelSkip">&#x2190; Zkusím to znovu</button>
                    <button class="btn-modal-confirm" @onclick="ConfirmSkip">&#x2192; Přeskočit</button>
                </div>
            </div>
        </div>
    }

    @if (showHintDialog)
    {
        <div class="modal-overlay" @onclick="CloseHintDialog">
            <div class="modal-content hint-modal" @onclick:stopPropagation="true">
                <h2>&#x1F4A1; Nápověda</h2>
                <p class="hint-dialog-text">@((MarkupString)GetHintText())</p>
                <div class="modal-buttons">
                    <button class="btn-modal-cancel" @onclick="CloseHintDialog">&#x2713; Rozumím, zkusím znovu</button>
                </div>
            </div>
        </div>
    }

    @if (showGiveUpDialog)
    {
        <div class="modal-overlay" @onclick="CloseGiveUpDialog">
            <div class="modal-content hint-modal" @onclick:stopPropagation="true">
                <h2>&#x1F4A1; Správné řešení</h2>
                <p class="hint-dialog-text">@((MarkupString)GetHintText())</p>
                @if (currentExerciseIndex < exercises.Count)
                {
                    <div class="solution-box">
                        <span class="solution-label">Správná odpověď:</span>
                        <span class="solution-text">@exercises[currentExerciseIndex].Exercise.CorrectAnswer</span>
                    </div>
                }
                <div class="modal-buttons">
                    <button class="btn-modal-cancel" @onclick="ConfirmGiveUp">Rozumím, jdeme dál &#x2192;</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<SessionExerciseData> exercises = new();
    private int currentExerciseIndex = 0;
    private string currentAnswer = "";
    private bool isSessionStarted = false;
    private bool isSessionCompleted = false;
    private bool isSaving = false;
    private bool showDetails = false;
    private ElementReference answerInput;
    private int sessionId = 0;
    private Stopwatch stopwatch = new();
    private int elapsedSeconds = 0;
    private int durationSeconds = 0;
    private int completedExercises = 0;
    private int totalExercisesSeen = 0;
    private int correctFirstAttempt = 0;
    private string durationType = "Time";
    private bool showEndConfirm = false;
    private bool showSkipConfirm = false;
    private bool showHintDialog = false;
    private bool showGiveUpDialog = false;
    private AddSubTrainingSettings? currentSettings = null;
    private AddSubExerciseGenerator? _generator = null;

    protected override async Task OnInitializedAsync()
    {
        var settings = SessionService.GetCurrentAddSubSettings() ?? new AddSubTrainingSettings();
        currentSettings = settings;
        durationType = settings.DurationType;
        _generator = new AddSubExerciseGenerator(settings);

        if (settings.DurationType == "Time")
        {
            durationSeconds = settings.DurationValue * 60;
            GenerateExercisesForTime();
        }
        else
        {
            durationSeconds = settings.DurationValue * 30;
            GenerateExercisesForCount(settings.DurationValue);
        }

        sessionId = (await TrainingService.CreateSessionAsync(
            ProfileService.CurrentProfileId,
            durationSeconds,
            settings.DurationType == "Count" ? settings.DurationValue : null,
            "ADD_SUB_100"
        )).SessionId;

        stopwatch.Start();
        isSessionStarted = true;
        _ = UpdateTimer();
    }

    private int _lastFocusedExerciseIndex = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isSessionCompleted) return;
        if (answerInput.Id == null) return;
        if (currentExerciseIndex >= exercises.Count) return;

        if (currentExerciseIndex != _lastFocusedExerciseIndex)
        {
            _lastFocusedExerciseIndex = currentExerciseIndex;
            if (!firstRender) await Task.Delay(50);
            await answerInput.FocusAsync();
        }
    }

    private void GenerateExercisesForTime()
    {
        exercises = Enumerable.Range(0, 10).Select((_, idx) => new SessionExerciseData
        {
            Index = idx,
            Exercise = _generator!.GenerateExercise(),
            Attempts = 0,
            IsCorrect = false,
            IsSkipped = false,
            TimeSpentSeconds = 0,
            StartTime = DateTime.UtcNow
        }).ToList();
    }

    private void GenerateExercisesForCount(int count)
    {
        exercises = Enumerable.Range(0, count).Select((_, idx) => new SessionExerciseData
        {
            Index = idx,
            Exercise = _generator!.GenerateExercise(),
            Attempts = 0,
            IsCorrect = false,
            IsSkipped = false,
            TimeSpentSeconds = 0,
            StartTime = DateTime.UtcNow
        }).ToList();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        Console.WriteLine($"Key pressed: {e.Key}");
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            Console.WriteLine("Enter detected, submitting answer...");
            await SubmitAnswer();
        }
    }

    private async Task SubmitAnswer()
    {
        if (string.IsNullOrWhiteSpace(currentAnswer))
            return;

        if (!int.TryParse(currentAnswer, out int answer))
            return;

        var currentExercise = exercises[currentExerciseIndex];
        currentExercise.Attempts++;
        currentExercise.UserAnswer = answer;

        if (answer == currentExercise.Exercise.CorrectAnswer)
        {
            currentExercise.IsCorrect = true;
            currentExercise.TimeSpentSeconds = (int)(DateTime.UtcNow - currentExercise.StartTime).TotalSeconds;
            if (currentExercise.Attempts == 1)
                correctFirstAttempt++;
            completedExercises++;

            if (elapsedSeconds >= durationSeconds && durationType == "Time")
            {
                await CompleteSessionAsync();
                return;
            }

            currentExerciseIndex++;
            currentAnswer = "";

            if (durationType == "Time" && currentExerciseIndex >= exercises.Count - 3)
            {
                GenerateMoreExercises();
            }

            if (currentExerciseIndex < exercises.Count)
            {
                exercises[currentExerciseIndex].StartTime = DateTime.UtcNow;
                StateHasChanged();
            }
            else
            {
                await CompleteSessionAsync();
            }
        }
        else
        {
            currentExercise.WrongAnswers.Add(answer);
            currentAnswer = "";
            StateHasChanged();
            if (answerInput.Id != null)
                await answerInput.FocusAsync();
        }
    }

    private async Task SkipExercise()
    {
        var currentExercise = exercises[currentExerciseIndex];
        currentExercise.IsSkipped = true;
        currentExercise.TimeSpentSeconds = (int)(DateTime.UtcNow - currentExercise.StartTime).TotalSeconds;

        currentExerciseIndex++;
        currentAnswer = "";

        if (currentExerciseIndex < exercises.Count)
        {
            exercises[currentExerciseIndex].StartTime = DateTime.UtcNow;
            StateHasChanged();
        }
        else
        {
            await CompleteSessionAsync();
        }
    }

    private void ToggleDetails()
    {
        showDetails = !showDetails;
    }

    private async Task CompleteSessionAsync()
    {
        stopwatch.Stop();
        isSessionCompleted = true;
        isSaving = true;
        StateHasChanged();

        var exercisesToSave = new List<Data.Models.SessionExercise>();

        foreach (var ex in exercises.Where(e => e.Attempts > 0 || e.IsSkipped || e.GaveUp))
        {
            exercisesToSave.Add(new Data.Models.SessionExercise
            {
                SessionId = sessionId,
                ExerciseIndex = ex.Index,
                ExerciseText = ex.Exercise.DisplayText,
                CorrectAnswer = ex.Exercise.CorrectAnswer,
                UserAnswer = ex.UserAnswer ?? 0,
                TimeSpentSeconds = ex.TimeSpentSeconds,
                NumberOfAttempts = ex.Attempts,
                IsCorrect = ex.IsCorrect,
                SkippedByUser = ex.IsSkipped,
                GaveUp = ex.GaveUp,
                HintShown = ex.HintShown,
                WrongAnswers = ex.WrongAnswers.Count > 0
                    ? string.Join(",", ex.WrongAnswers)
                    : null
            });
        }

        totalExercisesSeen = exercisesToSave.Count;

        try
        {
            await TrainingService.CompleteSessionAsync(sessionId, correctFirstAttempt, exercises.Sum(e => e.Attempts), exercisesToSave);
            Console.WriteLine("Session saved successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving session: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }

        StateHasChanged();
    }

    private void GoHome() => Navigation.NavigateTo("/");

    private void StartNewTraining() => Navigation.NavigateTo("/training/addsub/setup");

    private async Task UpdateTimer()
    {
        while (!isSessionCompleted && stopwatch.IsRunning)
        {
            await Task.Delay(1000);
            elapsedSeconds = (int)stopwatch.Elapsed.TotalSeconds;
            StateHasChanged();

            if (elapsedSeconds >= durationSeconds && exercises.Count > 0 && currentExerciseIndex < exercises.Count && durationType == "Time")
            {
                await CompleteSessionAsync();
            }
        }
    }

    private void ShowEndConfirmDialog()
    {
        Console.WriteLine(">>> Zobrazuji dialog pro ukončení tréninku");
        showEndConfirm = true;
    }

    private void CancelEndTraining()
    {
        Console.WriteLine(">>> Zrušeno ukončení, pokračuji v tréninku");
        showEndConfirm = false;
    }

    private async Task ConfirmEndTraining()
    {
        Console.WriteLine(">>> Potvrzeno ukončení tréninku");
        showEndConfirm = false;
        await EndTrainingEarly();
    }

    private void ShowSkipConfirmDialog()
    {
        Console.WriteLine(">>> Zobrazuji dialog pro přeskočení");
        showSkipConfirm = true;
    }

    private void CancelSkip()
    {
        Console.WriteLine(">>> Zrušeno přeskočení, pokračuji");
        showSkipConfirm = false;
    }

    private async Task ConfirmSkip()
    {
        Console.WriteLine(">>> Potvrzeno přeskočení");
        showSkipConfirm = false;
        await SkipExercise();
    }

    private void ShowHintDialog()
    {
        showHintDialog = true;
        if (currentExerciseIndex < exercises.Count)
            exercises[currentExerciseIndex].HintShown = true;
    }
    private void CloseHintDialog() { showHintDialog = false; }
    private void ShowGiveUpDialog() { showGiveUpDialog = true; }
    private void CloseGiveUpDialog() { showGiveUpDialog = false; }

    private async Task ConfirmGiveUp()
    {
        showGiveUpDialog = false;
        var currentExercise = exercises[currentExerciseIndex];
        currentExercise.TimeSpentSeconds = (int)(DateTime.UtcNow - currentExercise.StartTime).TotalSeconds;
        currentExercise.GaveUp = true;

        currentExerciseIndex++;
        currentAnswer = "";

        if (durationType == "Time" && currentExerciseIndex >= exercises.Count - 3)
            GenerateMoreExercises();

        if (currentExerciseIndex < exercises.Count)
        {
            exercises[currentExerciseIndex].StartTime = DateTime.UtcNow;
            StateHasChanged();
        }
        else
        {
            await CompleteSessionAsync();
        }
    }

    private string GetHintText()
    {
        if (currentExerciseIndex >= exercises.Count) return "";
        var ex = exercises[currentExerciseIndex];
        if (ex.UserAnswer == null) return "";

        var exercise = ex.Exercise;
        int wrong   = ex.UserAnswer.Value;
        int correct = exercise.CorrectAnswer;
        int a       = exercise.FirstNumber;
        int b       = exercise.SecondNumber;
        int diff    = Math.Abs(wrong - correct);
        bool tooHigh = wrong > correct;

        string closeText = diff switch
        {
            <= 2 => "&#x1F7E2; Skoro! Jsi velmi blízko – dej pozor na detail.",
            <= 5 => "&#x1F7E1; Nejsi daleko.",
            _    => "&#x1F534; Jsi dost daleko od správného výsledku."
        };

        string dirText = tooHigh
            ? $"Je příliš <strong>velký</strong> (o <strong class='hint-diff'>{diff}</strong>)."
            : $"Je příliš <strong>malý</strong> (o <strong class='hint-diff'>{diff}</strong>).";

        // Závorky / více čísel — nemůžeme jednoduše zpětně zrekonstruovat
        if (exercise.Operation is "parentheses" or "multi")
            return $"Počítej zleva doprava, krok za krokem.<br><br>{closeText}<br>{dirText}";

        // Určení typu ze zobrazení
        string display = exercise.DisplayText;
        bool hasFillIn = display.Contains("_");
        string checkLine;

        if (exercise.Operation == "+")
        {
            int fullResult = a + b;

            if (!hasFillIn)
            {
                // Přímé: a + b = ?   →  zpětná zkouška: wrong − b má dát a
                int check = wrong - b;
                checkLine = $"<span class='hint-calc'>{wrong}</span> − {b} = " +
                            $"<strong class='hint-check'>{check}</strong> " +
                            $"<span class='hint-expect'>(má být {a})</span>";
            }
            else
            {
                int opIdx  = display.IndexOf('+');
                int usIdx  = display.IndexOf('_');
                bool fillFirst = usIdx < opIdx;

                if (fillFirst)
                {
                    // _ + b = result  →  wrong + b má dát fullResult
                    int check = wrong + b;
                    checkLine = $"<strong class='hint-wrong'>{wrong}</strong> + {b} = " +
                                $"<strong class='hint-check'>{check}</strong> " +
                                $"<span class='hint-expect'>(má být {fullResult})</span>";
                }
                else
                {
                    // a + _ = result  →  a + wrong má dát fullResult
                    int check = a + wrong;
                    checkLine = $"{a} + <strong class='hint-wrong'>{wrong}</strong> = " +
                                $"<strong class='hint-check'>{check}</strong> " +
                                $"<span class='hint-expect'>(má být {fullResult})</span>";
                }
            }
        }
        else // "-"
        {
            int fullResult = a - b;

            if (!hasFillIn)
            {
                // Přímé: a − b = ?   →  zpětná zkouška: wrong + b má dát a
                int check = wrong + b;
                checkLine = $"<span class='hint-calc'>{wrong}</span> + {b} = " +
                            $"<strong class='hint-check'>{check}</strong> " +
                            $"<span class='hint-expect'>(má být {a})</span>";
            }
            else
            {
                int opIdx  = display.IndexOf('-');
                int usIdx  = display.IndexOf('_');
                bool fillFirst = usIdx < opIdx;

                if (fillFirst)
                {
                    // _ − b = result  →  wrong − b má dát fullResult
                    int check = wrong - b;
                    checkLine = $"<strong class='hint-wrong'>{wrong}</strong> − {b} = " +
                                $"<strong class='hint-check'>{check}</strong> " +
                                $"<span class='hint-expect'>(má být {fullResult})</span>";
                }
                else
                {
                    // a − _ = result  →  a − wrong má dát fullResult
                    int check = a - wrong;
                    checkLine = $"{a} − <strong class='hint-wrong'>{wrong}</strong> = " +
                                $"<strong class='hint-check'>{check}</strong> " +
                                $"<span class='hint-expect'>(má být {fullResult})</span>";
                }
            }
        }

        return $"Zpětná zkouška:<br>" +
               $"<div class='hint-check-box'>{checkLine}</div>" +
               $"{closeText}<br>{dirText}";
    }

    private async Task EndTrainingEarly()
    {
        Console.WriteLine(">>> Trénink ukončen předčasně!");
        await CompleteSessionAsync();
    }

    private void GenerateMoreExercises()
    {
        if (_generator == null || durationType != "Time")
            return;

        Console.WriteLine(">>> Generuji dalších 10 příkladů...");

        var startIndex = exercises.Count;
        for (int i = 0; i < 10; i++)
        {
            exercises.Add(new SessionExerciseData
            {
                Index = startIndex + i,
                Exercise = _generator.GenerateExercise(),
                Attempts = 0,
                IsCorrect = false,
                IsSkipped = false,
                TimeSpentSeconds = 0,
                StartTime = DateTime.UtcNow
            });
        }

        Console.WriteLine($">>> Celkem příkladů: {exercises.Count}");
    }

    private static string PrikladText(int n) => n switch
    {
        1 => "příklad",
        >= 2 and <= 4 => "příklady",
        _ => "příkladů"
    };

    private string GetExerciseFontSize()
    {
        if (currentExerciseIndex >= exercises.Count) return "clamp(2.5rem, 12vw, 5rem)";
        var len = exercises[currentExerciseIndex].Exercise.DisplayText.Length;
        return len switch
        {
            <= 9  => "clamp(2.5rem, 12vw, 5rem)",
            <= 13 => "clamp(2rem, 9vw, 4rem)",
            <= 17 => "clamp(1.6rem, 7vw, 3.2rem)",
            _     => "clamp(1.3rem, 5.5vw, 2.6rem)"
        };
    }
}

<style>
    .training-session-container {
        /* position: fixed + top/left/width/height jsou nastaveny JS (trainingLayout.init)
           přesně podle visualViewport – funguje korektně při otevření klávesnice na iOS i Android */
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: var(--training-vh, 100%); /* fallback než JS init proběhne */
        display: flex;
        flex-direction: column;
        align-items: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 0.75rem 1rem;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow: hidden;
    }

    .loading {
        color: white;
        font-size: 1.2rem;
    }

    .exercise-area {
        width: 100%;
        max-width: 500px;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .btn-details {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.4);
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8rem;
        align-self: flex-start;
        flex-shrink: 0;
    }

    .btn-details:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    .details-panel {
        width: 100%;
        display: flex;
        justify-content: space-between;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.9rem;
        margin-bottom: 1rem;
        padding: 0 1rem;
    }

    .exercise-display {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: clamp(3.2rem, 15vw, 6.5rem);
    }

    .exercise-text {
        font-weight: bold;
        color: white;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        text-align: center;
