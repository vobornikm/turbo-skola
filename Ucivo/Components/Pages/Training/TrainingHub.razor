@page "/training"
@rendermode InteractiveServer
@using TurboSkola.Services
@using TurboSkola.Data.Models
@inject ITrainingService TrainingService
@inject IPreparedTrainingService PreparedTrainingService
@inject IProfileService ProfileService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Tréninky - Turbo Škola</PageTitle>

<div class="hub-container">
    <div class="hub-header">
        <h1>🚀 Vyber si trénink</h1>
        <p class="hub-subtitle">Procvičuj různé předměty a posouvej se dál</p>
    </div>

    @if (pendingCount > 0 && !ProfileService.IsCurrentProfileParent)
    {
        <div class="prepared-banner" @onclick="GoToPrepared">
            <div class="prepared-banner-icon">
                <span class="prepared-count">@pendingCount</span>
            </div>
            <div class="prepared-banner-text">
                <strong>Máš připravené tréninky! 🎯</strong>
                <span>@pendingCount @TreninkText(pendingCount) na tebe @(pendingCount == 1 ? "čeká" : "čeká")</span>
            </div>
            <div class="prepared-banner-arrow">›</div>
        </div>
    }

    @if (ProfileService.IsCurrentProfileParent)
    {
        <div class="parent-prepared-link" @onclick="GoToPrepared">
            <span>📋</span>
            <span>Přehled připravených tréninků</span>
            <span class="prepared-banner-arrow">›</span>
        </div>
    }

    @if (groupedTrainings == null)
    {
        <div class="hub-loading">
            <p>Načítám tréninky...</p>
        </div>
    }
    else if (groupedTrainings.Count == 0)
    {
        <div class="hub-empty">
            <p>Zatím zde nejsou žádné tréninky. Brzy přidáme!</p>
        </div>
    }
    else
    {
        @foreach (var (subject, trainings) in groupedTrainings)
        {
            <div class="subject-section">
                <div class="subject-header" style="border-left: 5px solid @subject.Color">
                    <span class="subject-icon">@GetSubjectIcon(subject.Code)</span>
                    <h2>@subject.Name</h2>
                </div>
                <div class="trainings-grid">
                    @foreach (var training in trainings)
                    {
                        <div class="training-card" @onclick="() => NavigateToSetup(training.Code)" style="--card-color: @subject.Color">
                            <div class="training-card-icon">@GetTrainingIcon(training.Code)</div>
                            <div class="training-card-body">
                                <h3>@training.Name</h3>
                                <p>@training.Description</p>
                                <span class="training-grade">@training.MinGradeNumber.–@training.MaxGradeNumber. třída</span>
                            </div>
                            <div class="training-card-arrow">›</div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private List<(Subject Subject, List<TrainingType> Trainings)>? groupedTrainings;
    private int pendingCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var types = await TrainingService.GetTrainingTypesAsync();
        groupedTrainings = types
            .GroupBy(t => t.Subject.SubjectId)
            .Select(g => (g.First().Subject, g.ToList()))
            .ToList();

        // Check for pending prepared trainings
        if (ProfileService.CurrentProfileId.HasValue)
        {
            await PreparedTrainingService.AutoCompleteInProgressAsync(ProfileService.CurrentProfileId.Value);
            pendingCount = await PreparedTrainingService.GetPendingCountForProfileAsync(ProfileService.CurrentProfileId.Value);
        }
    }

    private void NavigateToSetup(string code)
    {
        var url = code switch
        {
            "SMALL_MULTIPLICATION" => "/training/setup",
            "ADD_SUB_100" => "/training/addsub/setup",
            "PAIRED_CONSONANTS" => "/training/czech/paired-consonants/setup",
            _ => "/training"
        };
        Navigation.NavigateTo(url);
    }

    private void GoToPrepared()
    {
        Navigation.NavigateTo("/training/prepared");
    }

    private static string TreninkText(int n) => n switch
    {
        1 => "trénink",
        >= 2 and <= 4 => "tréninky",
        _ => "tréninků"
    };

    private static string GetSubjectIcon(string code) => code switch
    {
        "MATH"  => "\U0001F9EE", // 🧮
        "CZECH" => "\U0001F4DA", // 📚
        _       => "\U0001F4D6"  // 📖
    };

    private static string GetTrainingIcon(string code) => code switch
    {
        "SMALL_MULTIPLICATION" => "\u2716\uFE0F", // ✖️
        "ADD_SUB_100"          => "\u2795",        // ➕
        "PAIRED_CONSONANTS"    => "\U0001F524",    // 🔤
        _                      => "\U0001F4DD"      // 📝
    };
}

<style>
    .hub-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
        min-height: 100vh;
    }

    .hub-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .hub-header h1 {
        font-size: 2.2rem;
        margin: 0 0 0.5rem 0;
        color: #2d3748;
    }

    .hub-subtitle {
        color: #718096;
        font-size: 1.1rem;
        margin: 0;
    }

    .hub-loading, .hub-empty {
        text-align: center;
        color: #718096;
        padding: 3rem;
    }

    .subject-section {
        margin-bottom: 2.5rem;
    }

    .subject-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding-left: 1rem;
        margin-bottom: 1.25rem;
    }

    .subject-icon {
        font-size: 1.75rem;
    }

    .subject-header h2 {
        margin: 0;
        font-size: 1.5rem;
        color: #2d3748;
    }

    .trainings-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .training-card {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        background: white;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        cursor: pointer;
        border: 2px solid transparent;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);
        transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
    }

    .training-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
        border-color: var(--card-color, #667eea);
    }

    .training-card-icon {
        font-size: 2.5rem;
        flex-shrink: 0;
    }

    .training-card-body {
        flex: 1;
        min-width: 0;
    }

    .training-card-body h3 {
        margin: 0 0 0.25rem 0;
        font-size: 1.15rem;
        color: #2d3748;
    }

    .training-card-body p {
        margin: 0 0 0.5rem 0;
        color: #718096;
        font-size: 0.9rem;
    }

    .training-grade {
        display: inline-block;
        background: #edf2f7;
        color: #4a5568;
        border-radius: 20px;
        padding: 0.15rem 0.65rem;
        font-size: 0.8rem;
    }

    .training-card-arrow {
        font-size: 1.75rem;
        color: #cbd5e0;
        font-weight: bold;
        flex-shrink: 0;
    }

    .training-card:hover .training-card-arrow {
        color: var(--card-color, #667eea);
    }

    /* Prepared trainings banner */
    .prepared-banner {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        border-radius: 14px;
        cursor: pointer;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        transition: transform 0.15s, box-shadow 0.15s;
        animation: pulseGlow 2s infinite;
    }

    .prepared-banner:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }

    @@keyframes pulseGlow {
        0%, 100% { box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3); }
        50% { box-shadow: 0 4px 25px rgba(102, 126, 234, 0.5); }
    }

    .prepared-banner-icon {
        flex-shrink: 0;
    }

    .prepared-count {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        background: rgba(255, 255, 255, 0.25);
        border-radius: 50%;
        font-size: 1.4rem;
        font-weight: 800;
    }

    .prepared-banner-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .prepared-banner-text strong {
        font-size: 1.05rem;
    }

    .prepared-banner-text span {
        font-size: 0.9rem;
        opacity: 0.9;
    }

    .prepared-banner-arrow {
        font-size: 1.75rem;
        font-weight: bold;
        opacity: 0.7;
    }

    .parent-prepared-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1.25rem;
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        cursor: pointer;
        margin-bottom: 1.5rem;
        color: #667eea;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.15s;
    }

    .parent-prepared-link:hover {
        border-color: #667eea;
        background: rgba(102, 126, 234, 0.04);
    }

    .parent-prepared-link .prepared-banner-arrow {
        margin-left: auto;
        color: #cbd5e0;
    }

    .parent-prepared-link:hover .prepared-banner-arrow {
        color: #667eea;
    }

    @@media (max-width: 480px) {
        .hub-header h1 {
            font-size: 1.6rem;
        }

        .training-card {
            padding: 1rem;
            gap: 1rem;
        }

        .training-card-icon {
            font-size: 2rem;
        }
    }
</style>
