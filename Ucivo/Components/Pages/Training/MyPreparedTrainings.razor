@page "/training/prepared"
@rendermode InteractiveServer
@using TurboSkola.Services
@using TurboSkola.Data.Models
@using TurboSkola.Utilities
@using System.Text.Json
@inject IPreparedTrainingService PreparedTrainingService
@inject IProfileService ProfileService
@inject ISessionService SessionService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Připravené tréninky - Turbo Škola</PageTitle>

<div class="prepared-container">

    <div class="prepared-header">
        <a href="/training" class="back-link">← Zpět na výběr</a>
        <h1>📋 Připravené tréninky</h1>
        <p class="subtitle">
            @if (ProfileService.IsCurrentProfileParent)
            {
                <span>Tréninky, které jsi připravil/a pro děti</span>
            }
            else
            {
                <span>Tréninky připravené speciálně pro tebe!</span>
            }
        </p>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <p>Načítám tréninky...</p>
        </div>
    }
    else if (ProfileService.IsCurrentProfileParent)
    {
        <!-- RODIČOVSKÝ PŘEHLED -->
        @if (createdTrainings == null || createdTrainings.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📋</div>
                <h2>Zatím žádné připravené tréninky</h2>
                <p>Jděte do nastavení libovolného tréninku a klikněte na „Připravit trénink pro dítě".</p>
                <a href="/training" class="btn-go-training">🚀 Jít na tréninky</a>
            </div>
        }
        else
        {
            <div class="parent-stats">
                <div class="stat-chip pending">⏳ @createdTrainings.Count(t => t.Status == "Pending") čekajících</div>
                <div class="stat-chip progress">🔄 @createdTrainings.Count(t => t.Status == "InProgress") probíhá</div>
                <div class="stat-chip completed">✅ @createdTrainings.Count(t => t.Status == "Completed") splněno</div>
            </div>

            <!-- Přepínač archiv -->
            <div class="archive-toggle" @onclick="ToggleShowArchived">
                <span>@(showArchived ? "🗂️ Skrýt archiv" : "🗂️ Zobrazit archiv (@archivedCount)")</span>
            </div>

            @foreach (var group in createdTrainings.GroupBy(t => t.AssignedToProfile.ProfileId))
            {
                var firstProfile = group.First().AssignedToProfile;
                var childBatches = GetOrderedBatches(firstProfile.ProfileId, group.ToList());

                <div class="child-group">
                    <h2 class="child-group-title">
                        <span class="child-group-avatar" style="background-color: @firstProfile.AvatarColor">
                            @((MarkupString)AvatarHelper.GetIcon(firstProfile.AvatarIcon))
                        </span>
                        @firstProfile.ProfileName
                    </h2>

                    @for (int bi = 0; bi < childBatches.Count; bi++)
                    {
                        var items = childBatches[bi];
                        var first = items.First();
                        var batchKey = first.BatchId ?? first.PreparedTrainingId.ToString();
                        var pendingCount = items.Count(t => t.Status == "Pending");
                        var inProgressCount = items.Count(t => t.Status == "InProgress");
                        var completedCount = items.Count(t => t.Status == "Completed");
                        var totalCount = items.Count(t => t.Status != "Cancelled" && t.Status != "Archived");
                        var allCompleted = totalCount > 0 && completedCount == totalCount;
                        var idx = bi;
                        var profileId = firstProfile.ProfileId;

                        @if (totalCount == 0)
                        {
                            <!-- Prázdný / plně zrušený batch — nabídnout smazání -->
                            <div class="batch-card batch-empty">
                                <div class="batch-header">
                                    <span class="batch-icon">@GetTrainingIcon(first.TrainingTypeCode)</span>
                                    <div class="batch-info">
                                        <div class="batch-title">@GetTrainingName(first.TrainingTypeCode)</div>
                                        <div class="batch-meta" style="color: #a0aec0;">Všechny položky zrušeny</div>
                                    </div>
                                </div>
                                <div class="batch-actions">
                                    @if (first.BatchId != null)
                                    {
                                        <button class="btn-cancel-batch" @onclick="() => DeleteBatch(first.BatchId!)">
                                            🗑️ Smazat
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                        <div class="batch-card @(allCompleted ? "batch-done" : "")">
                            <div class="batch-header">
                                <span class="batch-icon">@GetTrainingIcon(first.TrainingTypeCode)</span>
                                <div class="batch-info">
                                    <div class="batch-title">@GetTrainingName(first.TrainingTypeCode)</div>
                                    <div class="batch-meta">
                                        Vytvořeno @first.CreatedDate.ToLocalTime().ToString("d. M. yyyy")
                                        @if (!string.IsNullOrEmpty(first.Note))
                                        {
                                            <span class="batch-note">💬 @first.Note</span>
                                        }
                                    </div>
                                </div>
                                @if (childBatches.Count > 1 && !allCompleted)
                                {
                                    <div class="batch-reorder">
                                        <button class="btn-reorder @(idx == 0 ? "disabled" : "")" disabled="@(idx == 0)"
                                                @onclick="() => MoveBatchUp(profileId, idx)">▲</button>
                                        <button class="btn-reorder @(idx == childBatches.Count - 1 ? "disabled" : "")" disabled="@(idx == childBatches.Count - 1)"
                                                @onclick="() => MoveBatchDown(profileId, idx)">▼</button>
                                    </div>
                                }
                            </div>
                            <div class="batch-progress">
                                <div class="progress-bar">
                                    <div class="progress-fill @(allCompleted ? "fill-done" : "")" style="width: @(totalCount > 0 ? (completedCount * 100 / totalCount) : 0)%"></div>
                                </div>
                                <span class="progress-text">@completedCount / @totalCount splněno</span>
                            </div>
                            <div class="batch-actions">
                                @if (allCompleted && first.BatchId != null)
                                {
                                    <a href="/stats" class="btn-batch-action btn-stats">
                                        📊 Statistiky
                                    </a>
                                    <button class="btn-batch-action btn-archive" @onclick="() => ArchiveBatch(first.BatchId!)">
                                        ✓ Archivovat
                                    </button>
                                }
                                else if (first.BatchId != null)
                                {
                                    @if (pendingCount > 0)
                                    {
                                        <button class="btn-cancel-batch" @onclick="() => CancelBatch(first.BatchId!)">
                                            🗑️ Zrušit zbývajících @pendingCount
                                        </button>
                                    }
                                    @if (inProgressCount > 0 && pendingCount == 0)
                                    {
                                        <button class="btn-cancel-batch" @onclick="() => ResetInProgressBatch(first.BatchId!)">
                                            ↩️ Vrátit @inProgressCount rozpracovaných
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                        }
                    }
                </div>
            }
        }
    }
    else
    {
        <!-- DĚTSKÝ POHLED -->
        @if (pendingTrainings == null || pendingTrainings.Count == 0)
        {
            <div class="empty-state child-empty">
                <div class="empty-icon">🌟</div>
                <h2>Žádné tréninky nečekají</h2>
                <p>Super! Všechno máš splněno. Ale můžeš si jít zatrénovat sám/sama!</p>
                <a href="/training" class="btn-go-training">🚀 Jít trénovat</a>
            </div>
        }
        else
        {
            <div class="pending-banner">
                <span class="pending-count">@pendingTrainings.Count</span>
                <span>@TreninkText(pendingTrainings.Count) na tebe @CekaText(pendingTrainings.Count)!</span>
            </div>

            <div class="trainings-list">
                @foreach (var training in pendingTrainings)
                {
                    <div class="training-item @(training.Status == "InProgress" ? "in-progress" : "")" @onclick="() => StartTraining(training)">
                        <div class="training-item-icon">@GetTrainingIcon(training.TrainingTypeCode)</div>
                        <div class="training-item-body">
                            <h3>@GetTrainingName(training.TrainingTypeCode)</h3>
                            @if (!string.IsNullOrEmpty(training.Note))
                            {
                                <div class="training-note">
                                    💬 <em>@training.CreatedByProfile?.ProfileName říká:</em> @training.Note
                                </div>
                            }
                            @if (training.Status == "InProgress")
                            {
                                <span class="status-badge in-progress-badge">🔄 Rozpracováno</span>
                            }
                            else
                            {
                                <span class="status-badge pending-badge">⏳ Čeká na tebe</span>
                            }
                        </div>
                        <div class="training-item-arrow">›</div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<PreparedTraining>? pendingTrainings;
    private List<PreparedTraining>? createdTrainings;
    private bool isLoading = true;
    private bool showArchived = false;
    private int archivedCount = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated || !ProfileService.CurrentProfileId.HasValue)
        {
            Navigation.NavigateTo("/profile/select");
            return;
        }

        var profileId = ProfileService.CurrentProfileId.Value;
        await PreparedTrainingService.AutoCompleteInProgressAsync(profileId);

        if (ProfileService.IsCurrentProfileParent)
        {
            await RefreshParentDataAsync();
        }
        else
        {
            pendingTrainings = await PreparedTrainingService.GetPendingForProfileAsync(profileId);
        }
        isLoading = false;
    }

    private async Task RefreshParentDataAsync()
    {
        if (!ProfileService.CurrentProfileId.HasValue) return;
        var allTrainings = await PreparedTrainingService.GetCreatedByProfileAsync(ProfileService.CurrentProfileId.Value, includeArchived: true);
        archivedCount = allTrainings.Count(t => t.Status == "Archived");
        createdTrainings = showArchived ? allTrainings : allTrainings.Where(t => t.Status != "Archived").ToList();
    }

    private async Task ToggleShowArchived()
    {
        showArchived = !showArchived;
        await RefreshParentDataAsync();
        StateHasChanged();
    }

    private async Task StartTraining(PreparedTraining training)
    {
        // Mark as InProgress
        await PreparedTrainingService.MarkAsStartedAsync(training.PreparedTrainingId);

        // Set active prepared training for auto-completion tracking
        SessionService.SetActivePreparedTraining(training.PreparedTrainingId);

        // Deserialize settings and navigate to appropriate session
        switch (training.TrainingTypeCode)
        {
            case "SMALL_MULTIPLICATION":
                var multSettings = JsonSerializer.Deserialize<TrainingSettings>(training.SettingsJson);
                if (multSettings != null) SessionService.SetCurrentSettings(multSettings);
                Navigation.NavigateTo("/training/session");
                break;

            case "ADD_SUB_100":
                var addSubSettings = JsonSerializer.Deserialize<AddSubTrainingSettings>(training.SettingsJson);
                if (addSubSettings != null) SessionService.SetCurrentAddSubSettings(addSubSettings);
                Navigation.NavigateTo("/training/addsub/session");
                break;

            case "PAIRED_CONSONANTS":
                var pairedSettings = JsonSerializer.Deserialize<PairedConsonantsTrainingSettings>(training.SettingsJson);
                if (pairedSettings != null) SessionService.SetCurrentPairedConsonantsSettings(pairedSettings);
                Navigation.NavigateTo("/training/czech/paired-consonants/session");
                break;

            case "MIXED_MATH_100":
                var mixedSettings = JsonSerializer.Deserialize<MixedMathTrainingSettings>(training.SettingsJson);
                if (mixedSettings != null) SessionService.SetCurrentMixedMathSettings(mixedSettings);
                Navigation.NavigateTo("/training/mixedmath/session");
                break;

            default:
                Navigation.NavigateTo("/training");
                break;
        }
    }

    private async Task CancelBatch(string batchId)
    {
        await PreparedTrainingService.CancelBatchAsync(batchId);
        await RefreshParentDataAsync();
        StateHasChanged();
    }

    private async Task DeleteBatch(string batchId)
    {
        await PreparedTrainingService.DeleteBatchAsync(batchId);
        await RefreshParentDataAsync();
        StateHasChanged();
    }

    private async Task ResetInProgressBatch(string batchId)
    {
        await PreparedTrainingService.ResetInProgressBatchAsync(batchId);
        await RefreshParentDataAsync();
        StateHasChanged();
    }

    private async Task ArchiveBatch(string batchId)
    {
        await PreparedTrainingService.ArchiveBatchAsync(batchId);
        await RefreshParentDataAsync();
        StateHasChanged();
    }

    private static string GetTrainingIcon(string code) => code switch
    {
        "SMALL_MULTIPLICATION" => "✖️",
        "ADD_SUB_100" => "➕",
        "PAIRED_CONSONANTS" => "🔤",
        "MIXED_MATH_100" => "🧮",
        _ => "📝"
    };

    private static string GetTrainingName(string code) => code switch
    {
        "SMALL_MULTIPLICATION" => "Malá násobilka",
        "ADD_SUB_100" => "Sčítání a odčítání do 100",
        "PAIRED_CONSONANTS" => "Párové souhlásky",
        "MIXED_MATH_100" => "Smíšené počítání do 100",
        _ => "Trénink"
    };

    private static string TreninkText(int n) => n switch
    {
        1 => "trénink",
        >= 2 and <= 4 => "tréninky",
        _ => "tréninků"
    };

    private static string CekaText(int n) => n switch
    {
        1 => "čeká",
        _ => "čeká"
    };

    // Batch ordering per child (keyed by profileId)
    private Dictionary<int, List<string>> _batchOrderMap = new();

    private List<List<PreparedTraining>> GetOrderedBatches(int childProfileId, List<PreparedTraining> items)
    {
        var batches = items
            .GroupBy(t => t.BatchId ?? t.PreparedTrainingId.ToString())
            .ToDictionary(g => g.Key, g => g.ToList());

        if (!_batchOrderMap.ContainsKey(childProfileId))
        {
            _batchOrderMap[childProfileId] = batches.Keys.ToList();
        }
        else
        {
            var existing = _batchOrderMap[childProfileId];
            foreach (var key in batches.Keys.Where(k => !existing.Contains(k)))
                existing.Add(key);
            existing.RemoveAll(k => !batches.ContainsKey(k));
        }

        return _batchOrderMap[childProfileId]
            .Where(k => batches.ContainsKey(k))
            .Select(k => batches[k])
            .ToList();
    }

    private async Task MoveBatchUp(int childProfileId, int index)
    {
        if (!_batchOrderMap.ContainsKey(childProfileId) || index <= 0) return;
        var list = _batchOrderMap[childProfileId];
        (list[index - 1], list[index]) = (list[index], list[index - 1]);
        StateHasChanged();
        if (ProfileService.CurrentProfileId.HasValue)
            await PreparedTrainingService.SaveBatchOrderAsync(ProfileService.CurrentProfileId.Value, childProfileId, list);
    }

    private async Task MoveBatchDown(int childProfileId, int index)
    {
        if (!_batchOrderMap.ContainsKey(childProfileId)) return;
        var list = _batchOrderMap[childProfileId];
        if (index >= list.Count - 1) return;
        (list[index], list[index + 1]) = (list[index + 1], list[index]);
        StateHasChanged();
        if (ProfileService.CurrentProfileId.HasValue)
            await PreparedTrainingService.SaveBatchOrderAsync(ProfileService.CurrentProfileId.Value, childProfileId, list);
    }
}

