@page "/auth/login"
@rendermode InteractiveServer
@using TurboSkola.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Pøihlášení</PageTitle>

<LoadingSpinner IsLoading="@isLoading" Message="Pøihlašuji..." />

<div class="auth-container">
    <div class="auth-card">
        <h1>Pøihlášení</h1>
        
        <form @onsubmit="HandleLogin">
            <div class="form-group">
                <label for="email">E-mail:</label>
                <input type="email" 
                       id="email" 
                       @bind="email" 
                       placeholder="tvùj@email.cz"
                       required />
            </div>

            <div class="form-group">
                <label for="password">Heslo:</label>
                <input type="password" 
                       id="password" 
                       @bind="password" 
                       placeholder="Tvoje heslo"
                       required />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error" style="white-space: pre-wrap; font-size: 0.85rem; max-height: 400px; overflow-y: auto;">
                    @errorMessage
                </div>
            }

            <div class="remember-me-group">
                <label class="checkbox">
                    <input type="checkbox" @bind="rememberMe" />
                    <span>Zùstat pøihlášený (30 dní)</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Pøihlašuji...</span>
                }
                else
                {
                    <span>Pøihlásit se</span>
                }
            </button>
        </form>

        <p class="auth-link">
            Nemáš úèet? <a href="/auth/register">Registruj se zde</a>
        </p>

        <p class="back-link">
            <a href="/">Zpìt na domù</a>
        </p>
    </div>
</div>

@code {
private string email = "";
private string password = "";
private bool rememberMe = true; // Default zaškrtnuto
private string errorMessage = "";
private bool isLoading = false;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "E-mail a heslo jsou povinné.";
            return;
        }

        isLoading = true;
        errorMessage = "";
        StateHasChanged(); // Explicitnì øíct Blazoru, aby pøekreslil UI

        try
        {
            Console.WriteLine("[Login] Starting login...");
            // Malá pauza pro zobrazení spinneru
            await Task.Delay(100);
            
            var result = await AuthService.LoginAsync(email, password, rememberMe, JSRuntime);
            Console.WriteLine($"[Login] Result from LoginAsync: {result}");
            
            if (result)
            {
                Console.WriteLine("[Login] Login successful, navigating to profile select...");
                // Poèkat na uložení do AuthService
                await Task.Delay(100);
                Navigation.NavigateTo("/profile/select", forceLoad: false);
            }
            else
            {
                Console.WriteLine("[Login] Login failed");
                errorMessage = "Nesprávný e-mail nebo heslo.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"EXCEPTION: {ex.GetType().Name}\nMessage: {ex.Message}\n\nStack:\n{ex.StackTrace?.Substring(0, Math.Min(500, ex.StackTrace?.Length ?? 0))}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}

