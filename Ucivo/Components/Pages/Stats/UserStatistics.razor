@page "/stats"
@rendermode InteractiveServer
@using TurboSkola.Services
@using TurboSkola.Data
@using TurboSkola.Data.Models
@using TurboSkola.Utilities
@using Microsoft.EntityFrameworkCore
@inject IAuthService AuthService
@inject IProfileService ProfileService
@inject UcivoDbContext DbContext
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Moje Statistiky</PageTitle>

<LoadingSpinner IsLoading="@isLoading" Message="Načítám statistiky..." />

@if (!AuthService.IsAuthenticated)
{
    <div class="stats-container">
        <div class="alert alert-warning">
            <p>Musíš se přihlásit, abys mohl vidět své statistiky.</p>
            <a href="/auth/login" class="btn btn-primary">Přihlásit se</a>
        </div>
    </div>
}
else
{
    <div class="stats-container">
        <div class="header">
            <h1>&#x1F4CA; Moje Statistiky</h1>
            @if (ProfileService.CurrentProfileName != null)
            {
                <p class="stats-profile-info">Profil: <strong>@ProfileService.CurrentProfileName</strong></p>
            }
        </div>

        @if (ProfileService.IsCurrentProfileParent && childProfiles != null && childProfiles.Any())
        {
            <div class="tabs-container">
                <div class="tabs">
                    <button class="tab @(selectedTab == "overview" ? "active" : "")"
                            @onclick='() => SwitchTab("overview")'>
                        &#x1F4CA; Přehled
                    </button>
                    @foreach (var child in childProfiles)
                    {
                        <button class="tab @(selectedTab == child.ProfileId.ToString() ? "active" : "")"
                                style="border-bottom: 3px solid @(selectedTab == child.ProfileId.ToString() ? child.AvatarColor : "transparent")"
                                @onclick='() => SwitchTab(child.ProfileId.ToString())'>
                            @((MarkupString)GetAvatarIcon(child.AvatarIcon)) @child.ProfileName
                        </button>
                    }
                </div>
            </div>

            @if (selectedTab == "overview")
            {
                <h2 style="margin-top: 2rem;">Celkové statistiky všech dětí</h2>
                @if (allChildrenSessions != null && allChildrenSessions.Any())
                {
                    var totalEx = allChildrenSessions.Sum(s => s.TotalExamples);
                    var correctEx = allChildrenSessions.Sum(s => s.CorrectFirstAttempt);
                    var successPct = totalEx > 0 ? (double)correctEx / totalEx * 100 : 0;

                    <div class="stats-grid">
                        <div class="stat-card">
                            <h3>Celkem tréninků</h3>
                            <p class="stat-value">@allChildrenSessions.Count</p>
                        </div>
                        <div class="stat-card">
                            <h3>Celkový čas</h3>
                            <p class="stat-value">@TimeSpan.FromSeconds(allChildrenSessions.Sum(s => s.DurationSeconds)).ToString(@"hh\:mm\:ss")</p>
                        </div>
                        <div class="stat-card">
                            <h3>Celkem příkladů</h3>
                            <p class="stat-value">@allChildrenSessions.Sum(s => s.TotalExamples)</p>
                        </div>
                        <div class="stat-card">
                            <h3>Úspěšnost</h3>
                            <p class="stat-value success-rate">@successPct.ToString("F1")%</p>
                        </div>
                    </div>

                    <h3 style="margin-top: 2rem;">Statistiky po dětech</h3>
                    <div class="children-stats">
                        @foreach (var child in childProfiles)
                        {
                            var childSessions = allChildrenSessions.Where(s => s.ProfileId == child.ProfileId).ToList();
                            if (childSessions.Any())
                            {
                                var cTotal = childSessions.Sum(s => s.TotalExamples);
                                var cCorrect = childSessions.Sum(s => s.CorrectFirstAttempt);
                                var cSuccess = cTotal > 0 ? (double)cCorrect / cTotal * 100 : 0;

                                <div class="child-stat-card" style="border-left: 4px solid @child.AvatarColor; cursor: pointer;" @onclick='() => selectedTab = child.ProfileId.ToString()'>
                                    <h4>@((MarkupString)GetAvatarIcon(child.AvatarIcon)) @child.ProfileName</h4>
                                    <div class="child-stats-grid">
                                        <div><strong>Tréninky:</strong> @childSessions.Count</div>
                                        <div><strong>Čas:</strong> @TimeSpan.FromSeconds(childSessions.Sum(s => s.DurationSeconds)).ToString(@"mm\:ss")</div>
                                        <div><strong>Příklady:</strong> @cTotal</div>
                                        <div><strong>Úspěšnost:</strong> @cSuccess.ToString("F1")%</div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <p style="text-align: center; margin-top: 2rem;">Děti zatím nemají žádné tréninky.</p>
                }
            }
            else
            {
                var selectedProfileId = int.Parse(selectedTab);
                var selectedChild = childProfiles.FirstOrDefault(p => p.ProfileId == selectedProfileId);
                var selectedSessions = allChildrenSessions?.Where(s => s.ProfileId == selectedProfileId).OrderByDescending(s => s.EndTime).ToList();

                if (selectedChild != null)
                {
                    <h2 style="margin-top: 2rem;">@((MarkupString)GetAvatarIcon(selectedChild.AvatarIcon)) Statistiky: @selectedChild.ProfileName</h2>
                }

                if (selectedSessions == null || !selectedSessions.Any())
                {
                    <p style="text-align: center; margin-top: 2rem;">Toto dítě zatím nemá žádné tréninky.</p>
                }
                else
                {
                    @RenderStats(selectedSessions)
                }
            }
        }
        else
        {
            @if (trainingSessions == null)
            {
                <p>Načítám...</p>
            }
            else if (trainingSessions.Count == 0)
            {
                <div class="no-data">
                    <p>Zatím nemáš žádný trénink. Začni trénovat!</p>
                    <a href="/training/setup" class="btn btn-primary">Spustit trénink</a>
                </div>
            }
            else
            {
                @RenderStats(trainingSessions)
            }
        }

        <a href="/" class="btn btn-secondary" style="margin-top: 2rem;">Zpět na domů</a>
    </div>
}

@if (showDeleteDialog && deletingSessionId.HasValue)
{
    <div class="delete-confirm-overlay" @onclick="CancelDeleteSession">
        <div class="delete-confirm-dialog" @onclick:stopPropagation>
            @if (!pinVerifiedForDelete)
            {
                <h3>Zadej PIN rodičovského profilu</h3>
                <p>Pro smazání tréninku zadej PIN.</p>

                <PinInput Title=""
                          Hint="Zadej 4-místný PIN"
                          OnPinEntered="VerifyDeleteSessionPin"
                          OnCancel="CancelDeleteSession"
                          ErrorMessage="@deletePinError" />
            }
            else
            {
                <h3>Smazat trénink?</h3>
                <p>Opravdu chceš smazat tento trénink?</p>
                <p class="warning-text">
                    <span style="font-size: 1.2rem;">&#x26A0;</span> Tato akce je nevratná!
                </p>
                <div class="dialog-actions">
                    <button class="btn btn-secondary" @onclick="CancelDeleteSession">Zrušit</button>
                    <button class="btn btn-danger" @onclick="ExecuteDeleteSession">Smazat</button>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<TrainingSession>? trainingSessions;
    private List<UserProfile>? childProfiles;
    private List<TrainingSession>? allChildrenSessions;
    private string selectedTab = "overview";
    private bool isLoading = false;
    private int? expandedSessionId = null;
    private List<SessionExercise>? expandedExercises = null;
    private bool loadingExercises = false;
    private List<ProblematicExercise>? problematicExercises = null;
    private ExerciseSortOrder exerciseSortOrder = ExerciseSortOrder.Default;

    private bool showDeleteDialog = false;
    private int? deletingSessionId = null;
    private bool pinVerifiedForDelete = false;
    private string? deletePinError;
    private HashSet<string> selectedTrainingTypes = new();

    private enum ExerciseSortOrder { Default, ByErrors, ByTime }

    private IEnumerable<string> GetAvailableTypes(List<TrainingSession> sessions) =>
        sessions.Select(s => s.TrainingTypeCode ?? "").Distinct().OrderBy(c => c);

    private void ToggleTypeFilter(string code)
    {
        if (!selectedTrainingTypes.Add(code))
            selectedTrainingTypes.Remove(code);
    }

    private void SwitchTab(string tab)
    {
        selectedTab = tab;
        selectedTrainingTypes.Clear();
    }

    private List<TrainingSession> FilteredSessions(List<TrainingSession> sessions) =>
        selectedTrainingTypes.Count == 0
            ? sessions
            : sessions.Where(s => selectedTrainingTypes.Contains(s.TrainingTypeCode ?? "")).ToList();

    private static string NormalizeTypeCode(string? code) => code ?? "";

    private static string GetTrainingTypeLabel(string? code) => code switch
    {
        "SMALL_MULTIPLICATION" => "\u2716\uFE0F N\u00e1sobilka",
        "ADD_SUB_100"          => "\u2795 S\u010d\u00edt\u00e1n\u00ed / Od\u010d\u00edt\u00e1n\u00ed",
        _                      => "\U0001F4DA Tr\u00e9nink"
    };

    private static string GetTrainingTypeBadgeClass(string? code) => code switch
    {
        "SMALL_MULTIPLICATION" => "badge-mul",
        "ADD_SUB_100"          => "badge-addsub",
        _                      => "badge-other"
    };

    private class ProblematicExercise
    {
        public string Exercise { get; set; } = "";
        public int WrongCount { get; set; }
        public int SkippedCount { get; set; }
        public int GaveUpCount { get; set; }
        public int TotalErrors { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ProfileService.OnProfileChanged += OnProfileChangedHandler;
            await LoadDataAsync();
        }
    }

    private async void OnProfileChangedHandler()
    {
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataAsync()
    {
        if (!AuthService.IsAuthenticated) return;

        isLoading = true;
        StateHasChanged();
        try
        {
            trainingSessions = await DbContext.TrainingSessions
                .Where(s => s.ProfileId == ProfileService.CurrentProfileId)
                .OrderByDescending(s => s.EndTime)
                .Take(100)
                .ToListAsync();

            if (trainingSessions.Any())
            {
                await LoadProblematicExercises(trainingSessions);
            }

            if (ProfileService.IsCurrentProfileParent && AuthService.CurrentUserId.HasValue)
            {
                childProfiles = await DbContext.UserProfiles
                    .Where(p => p.UserId == AuthService.CurrentUserId.Value
                             && p.IsActive
                             && !p.IsParentProfile)
                    .OrderBy(p => p.DisplayOrder)
                    .ToListAsync();

                if (childProfiles.Any())
                {
                    var childIds = childProfiles.Select(p => p.ProfileId).ToList();
                    allChildrenSessions = await DbContext.TrainingSessions
                        .Where(s => s.ProfileId != null && childIds.Contains(s.ProfileId.Value))
                        .OrderByDescending(s => s.EndTime)
                        .ToListAsync();
                }
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadProblematicExercises(List<TrainingSession> sessions)
    {
        var sessionIds = sessions.Select(s => s.SessionId).ToList();

        problematicExercises = await DbContext.SessionExercises
            .Where(e => sessionIds.Contains(e.SessionId))
            .Where(e => e.NumberOfAttempts > 0 && (!e.IsCorrect || e.SkippedByUser || e.GaveUp))
            .GroupBy(e => e.ExerciseText)
            .Select(g => new ProblematicExercise
            {
                Exercise = g.Key,
                WrongCount = g.Count(e => !e.IsCorrect && !e.SkippedByUser && !e.GaveUp),
                SkippedCount = g.Count(e => e.SkippedByUser),
                GaveUpCount = g.Count(e => e.GaveUp),
                TotalErrors = g.Count()
            })
            .OrderByDescending(e => e.TotalErrors)
            .Take(10)
            .ToListAsync();
    }

    private RenderFragment RenderStats(List<TrainingSession> sessions)
    {
        int total = sessions.Sum(s => s.TotalExamples);
        int correct = sessions.Sum(s => s.CorrectFirstAttempt);
        double percentage = total > 0 ? (double)correct / total * 100 : 0;

        return @<text>
            <div class="stats-grid">
                <div class="stat-card">
                    <h3>Počet tréninků</h3>
                    <p class="stat-value">@sessions.Count</p>
                </div>
                <div class="stat-card">
                    <h3>Celkový čas</h3>
                    <p class="stat-value">@TimeSpan.FromSeconds(sessions.Sum(s => s.DurationSeconds)).ToString(@"hh\:mm\:ss")</p>
                </div>
                <div class="stat-card">
                    <h3>Příkladů celkem</h3>
                    <p class="stat-value">@sessions.Sum(s => s.TotalExamples)</p>
                </div>
                <div class="stat-card">
                    <h3>Správně napoprvé</h3>
                    <p class="stat-value">@correct / @total</p>
                    <p class="stat-percentage">(@percentage.ToString("F1")%)</p>
                </div>
            </div>

        @RenderProblematicExercises(sessions)

            <div class="recent-sessions">
                <h2>Poslední tréninky</h2>

                @{
                    var availableTypes = GetAvailableTypes(sessions).ToList();
                    var displaySessions = FilteredSessions(sessions);
                }

                @if (availableTypes.Count > 1)
                {
                    <div class="type-filter">
                        @foreach (var code in availableTypes)
                        {
                            bool sel = selectedTrainingTypes.Contains(code);
                            <button class="type-chip @(sel ? "selected " + GetTrainingTypeBadgeClass(code) : "")"
                                    @onclick="() => { ToggleTypeFilter(code); StateHasChanged(); }">
                                @GetTrainingTypeLabel(code == "" ? null : code)
                            </button>
                        }
                        @if (selectedTrainingTypes.Count > 0)
                        {
                            <button class="type-chip-clear" @onclick="() => { selectedTrainingTypes.Clear(); StateHasChanged(); }">
                                ✕ Vše
                            </button>
                        }
                    </div>
                }

                <div class="sessions-list">
                    @foreach (var session in displaySessions.Take(50))
                    {
                        double accuracy = session.TotalExamples > 0 ? (double)session.CorrectFirstAttempt / session.TotalExamples * 100 : 0;
                        string accuracyClass = accuracy >= 80 ? "accuracy-high" : accuracy >= 60 ? "accuracy-medium" : "accuracy-low";
                        bool isExpanded = expandedSessionId == session.SessionId;

                        <div class="session-card @(isExpanded ? "expanded" : "")">
                            <div class="session-item" @onclick="() => ToggleSessionDetail(session.SessionId)">
                                <div class="session-left">
                                    <div class="session-date">@session.EndTime.ToString("dd.MM.yyyy HH:mm")</div>
                                    <span class="session-type-badge @GetTrainingTypeBadgeClass(session.TrainingTypeCode)">
                                        @GetTrainingTypeLabel(session.TrainingTypeCode)
                                    </span>
                                </div>
                                <div class="session-stats">
                                    <span>@session.TotalExamples @PrikladText(session.TotalExamples)</span>
                                    <span>@TimeSpan.FromSeconds(session.DurationSeconds).ToString(@"mm\:ss")</span>
                                    <span>@session.CorrectFirstAttempt/@session.TotalExamples správně</span>
                                </div>
                                <div class="session-accuracy">
                                    <span class="@accuracyClass">@accuracy.ToString("F0")%</span>
                                    <span class="expand-icon">@(isExpanded ? "▼" : "▶")</span>
                                </div>
                            </div>

                            @if (isExpanded)
                            {
                                <div class="session-detail">
                                    @if (ProfileService.IsCurrentProfileParent)
                                    {
                                        <div class="session-actions">
                                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteSession(session.SessionId)" @onclick:stopPropagation>
                                                Smazat trénink
                                            </button>
                                        </div>
                                    }

                                    @if (loadingExercises)
                                    {
                                        <p style="text-align: center; padding: 1rem;">Načítám detaily...</p>
                                    }
                                    else if (expandedExercises != null && expandedExercises.Any())
                                    {
                                        <div class="exercises-header">
                                            <h4>Detail příkladů:</h4>
                                            <div class="sort-buttons">
                                                <button class="sort-btn @(exerciseSortOrder == ExerciseSortOrder.Default ? "active" : "")"
                                                        @onclick="() => { exerciseSortOrder = ExerciseSortOrder.Default; StateHasChanged(); }">
                                                    📋 Pořadí
                                                </button>
                                                <button class="sort-btn @(exerciseSortOrder == ExerciseSortOrder.ByErrors ? "active" : "")"
                                                        @onclick="() => { exerciseSortOrder = ExerciseSortOrder.ByErrors; StateHasChanged(); }">
                                                    ⚠️ Chyby
                                                </button>
                                                <button class="sort-btn @(exerciseSortOrder == ExerciseSortOrder.ByTime ? "active" : "")"
                                                        @onclick="() => { exerciseSortOrder = ExerciseSortOrder.ByTime; StateHasChanged(); }">
                                                    ⏱️ Čas
                                                </button>
                                            </div>
                                        </div>
                                        <div class="exercises-grid">
                                            @foreach (var exercise in SortedExercises())
                                            {
                                                string exerciseClass;
                                                if (exercise.SkippedByUser)
                                                    exerciseClass = "exercise-skipped";
                                                else if (exercise.GaveUp)
                                                    exerciseClass = "exercise-gaveup";
                                                else if (!exercise.IsCorrect)
                                                    exerciseClass = "exercise-wrong";
                                                else if (exercise.NumberOfAttempts == 1)
                                                    exerciseClass = "exercise-correct";
                                                else
                                                    exerciseClass = "exercise-correct-late";

                                                var wrongAnswersList = string.IsNullOrEmpty(exercise.WrongAnswers)
                                                    ? new List<string>()
                                                    : exercise.WrongAnswers.Split(',').ToList();

                                                <div class="exercise-item @exerciseClass">
                                                    <span class="exercise-number">#@(exercise.ExerciseIndex + 1)</span>
                                                    <span class="exercise-text">@exercise.ExerciseText = ?</span>
                                                    <div class="exercise-status">
                                                        @if (exercise.HintShown)
                                                        {
                                                            <span class="badge badge-hint" title="Zobrazil nápovědu">💡</span>
                                                        }
                                                        @if (exercise.SkippedByUser)
                                                        {
                                                            <span class="outcome-label outcome-skipped">⊘ Přeskočeno</span>
                                                        }
                                                        else if (exercise.GaveUp)
                                                        {
                                                            <span class="outcome-label outcome-gaveup">🏳 Dal se podat</span>
                                                        }
                                                        else if (exercise.IsCorrect)
                                                        {
                                                            <span class="outcome-label @(exercise.NumberOfAttempts == 1 ? "outcome-correct" : "outcome-correct-late")">✓ Správně</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="outcome-label outcome-wrong">✗ Špatně</span>
                                                        }
                                                    </div>
                                                    <div class="exercise-detail">
                                                        @if (wrongAnswersList.Any())
                                                        {
                                                            @foreach (var wrong in wrongAnswersList)
                                                            {
                                                                <span class="wrong-answer-chip">@wrong</span>
                                                            }
                                                        }
                                                        @if (exercise.IsCorrect && !exercise.SkippedByUser && !exercise.GaveUp)
                                                        {
                                                            <span class="correct-value">✓ @exercise.CorrectAnswer</span>
                                                        }
                                                        else if (exercise.SkippedByUser || exercise.GaveUp)
                                                        {
                                                            <span class="correct-value-reveal">= @exercise.CorrectAnswer</span>
                                                        }
                                                    </div>
                                                    <div class="exercise-meta">
                                                        <span class="exercise-attempts">@exercise.NumberOfAttempts× pokus</span>
                                                        <span class="exercise-time">@exercise.TimeSpentSeconds s</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p style="text-align: center; padding: 1rem;">Žádné detaily k dispozici.</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </text>;
    }

    private async Task ToggleSessionDetail(int sessionId)
    {
        if (expandedSessionId == sessionId)
        {
            expandedSessionId = null;
            expandedExercises = null;
            exerciseSortOrder = ExerciseSortOrder.Default;
        }
        else
        {
            expandedSessionId = sessionId;
            exerciseSortOrder = ExerciseSortOrder.Default;
            loadingExercises = true;
            StateHasChanged();

            try
            {
                expandedExercises = await DbContext.SessionExercises
                    .Where(e => e.SessionId == sessionId)
                    .OrderBy(e => e.ExerciseIndex)
                    .ToListAsync();
            }
            finally
            {
                loadingExercises = false;
                StateHasChanged();
            }
        }
    }

    private IEnumerable<SessionExercise> SortedExercises() => exerciseSortOrder switch
    {
        ExerciseSortOrder.ByErrors => (expandedExercises ?? [])
            .OrderBy(e => e.SkippedByUser ? 0
                        : e.GaveUp ? 1
                        : (!string.IsNullOrEmpty(e.WrongAnswers) || !e.IsCorrect) ? 2
                        : 3)
            .ThenBy(e => e.ExerciseIndex),
        ExerciseSortOrder.ByTime => (expandedExercises ?? [])
            .OrderByDescending(e => e.TimeSpentSeconds),
        _ => (expandedExercises ?? [])
            .OrderBy(e => e.ExerciseIndex)
    };

    private RenderFragment RenderProblematicExercises(List<TrainingSession> sessions)
    {
        return @<text>
            <div class="problematic-section">
                <h2>&#x26A0; Problematické příklady</h2>
                <p class="section-hint">Příklady, které byly nejčastěji špatně nebo přeskočeny</p>

                @if (problematicExercises == null || !problematicExercises.Any())
                {
                    <p style="text-align: center; color: #48bb78; padding: 2rem;">
                        &#x1F389; Skvělé! Žádné problematické příklady!
                    </p>
                }
                else
                {
                    <div class="problematic-grid">
                        @foreach (var item in problematicExercises)
                        {
                            <div class="problematic-item">
                                <div class="problematic-exercise">@item.Exercise = ?</div>
                                <div class="problematic-stats">
                                    @if (item.WrongCount > 0)
                                    {
                                        <span class="error-count wrong">✗ @item.WrongCount× špatně</span>
                                    }
                                    @if (item.GaveUpCount > 0)
                                    {
                                        <span class="error-count gaveup">🏳 @item.GaveUpCount× podat</span>
                                    }
                                    @if (item.SkippedCount > 0)
                                    {
                                        <span class="error-count skipped">⊘ @item.SkippedCount× přeskočeno</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </text>;
    }

    private void ConfirmDeleteSession(int sessionId)
    {
        deletingSessionId = sessionId;
        pinVerifiedForDelete = false;
        deletePinError = null;
        showDeleteDialog = true;
    }

    private void CancelDeleteSession()
    {
        deletingSessionId = null;
        pinVerifiedForDelete = false;
        deletePinError = null;
        showDeleteDialog = false;
    }

    private async Task VerifyDeleteSessionPin(string pin)
    {
        if (!ProfileService.IsCurrentProfileParent || !ProfileService.CurrentProfileId.HasValue)
        {
            deletePinError = "Musíš být přihlášený jako rodič!";
            StateHasChanged();
            return;
        }

        var isValid = await ProfileService.VerifyPinAsync(ProfileService.CurrentProfileId.Value, pin);

        if (isValid)
        {
            pinVerifiedForDelete = true;
            deletePinError = null;
            StateHasChanged();
        }
        else
        {
            deletePinError = "Nesprávný PIN!";
            StateHasChanged();
        }
    }

    private async Task ExecuteDeleteSession()
    {
        if (!deletingSessionId.HasValue || !pinVerifiedForDelete) return;

        try
        {
            var exercises = await DbContext.SessionExercises
                .Where(e => e.SessionId == deletingSessionId.Value)
                .ToListAsync();

            DbContext.SessionExercises.RemoveRange(exercises);

            var session = await DbContext.TrainingSessions
                .FirstOrDefaultAsync(s => s.SessionId == deletingSessionId.Value);

            if (session != null)
            {
                DbContext.TrainingSessions.Remove(session);
                await DbContext.SaveChangesAsync();

                await LoadDataAsync();

                expandedSessionId = null;
                expandedExercises = null;
            }
        }
        finally
        {
            CancelDeleteSession();
        }
    }

    private string GetAvatarIcon(string icon) => AvatarHelper.GetIcon(icon);

    private static string PrikladText(int n) => n switch
    {
        1 => "příklad",
        >= 2 and <= 4 => "příklady",
        _ => "příkladů"
    };

    public void Dispose()
    {
        ProfileService.OnProfileChanged -= OnProfileChangedHandler;
    }
}

