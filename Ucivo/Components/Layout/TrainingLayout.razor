@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject IProfileService ProfileService
@using TurboSkola.Services
@implements IAsyncDisposable

@* Layout bez menu - pro tréninkovou session *@
<div class="training-fullscreen">
    @Body
</div>

<style>
    html, body {
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
        overscroll-behavior: none;
        /* Gradient jako záchranná síť – žádná bílá/fialová plocha při přechodech */
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .training-fullscreen {
        /* Průhledný wrapper – .training-session-container se pozicuje sám přes JS */
        display: contents;
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("trainingLayout.init");

            // Obnovit auth + profil (MainLayout se tady nepoužívá)
            await AuthService.TryAutoLoginAsync(JSRuntime);
            if (AuthService.IsAuthenticated)
                await ProfileService.TryRestoreProfileAsync(JSRuntime);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await JSRuntime.InvokeVoidAsync("trainingLayout.destroy");
    }
}
