@inherits LayoutComponentBase
@using TurboSkola.Services
@inject IAuthService AuthService
@inject IProfileService ProfileService
@inject IJSRuntime JSRuntime

@if (!authInitialized)
{
    @* Počkej na načtení auth - nezobrazuj stránky dokud nevíme jestli je přihlášen *@
    <div class="auth-loading">
        <div class="auth-loading-spinner"></div>
    </div>
}
else
{
    <div class="app-container">
        <NavMenu />
        <main class="main-content">
            @Body
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool authInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.TryAutoLoginAsync(JSRuntime);
            if (AuthService.IsAuthenticated)
                await ProfileService.TryRestoreProfileAsync(JSRuntime);
            authInitialized = true;
            StateHasChanged();
        }
    }
}

<style>
    .auth-loading {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .auth-loading-spinner {
        width: 48px;
        height: 48px;
        border: 5px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>
